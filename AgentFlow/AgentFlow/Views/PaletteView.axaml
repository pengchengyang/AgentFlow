<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AgentFlow.ViewModels"
             xmlns:s="clr-namespace:AgentFlow.Services"
             x:Class="AgentFlow.Views.PaletteView"
             x:DataType="vm:MainViewModel">

  <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
    <DockPanel Margin="12,14">
      <!-- 搜索框：可输入 -->
      <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
              CornerRadius="8" Padding="10,0" Margin="0,0,0,14">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" Text="{Binding SearchText}"
                   PlaceholderText="Search"
                   BorderThickness="0" Background="Transparent"
                   Padding="8,6" FontSize="13" VerticalAlignment="Center">
            <TextBox.Styles>
              <Style Selector="TextBox:focus">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
              </Style>
              <Style Selector="TextBox /template/ Border#PART_BorderElement">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
              </Style>
            </TextBox.Styles>
          </TextBox>
          <Border Grid.Column="2" Background="#F3F4F6" CornerRadius="3" Padding="4,1">
            <TextBlock Text="/" FontSize="11" Foreground="#9CA3AF"/>
          </Border>
        </Grid>
      </Border>

      <!-- Components 标题 -->
      <Grid DockPanel.Dock="Top" Margin="4,0,4,6">
        <TextBlock Text="Components" FontWeight="SemiBold" FontSize="13" Foreground="#111827"/>
        <TextBlock Text="⚙" FontSize="13" Foreground="#9CA3AF" HorizontalAlignment="Right"/>
      </Grid>

      <!-- 底部 Discover -->
      <Border DockPanel.Dock="Bottom" Background="#F3F4F6" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="⊞" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center"/>
          <TextBlock Text="Discover more components" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- 分类列表 -->
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="0">
          <Border Padding="10,9" CornerRadius="6">
            <Border.Styles><Style Selector="Border:pointerover"><Setter Property="Background" Value="#F3F4F6"/></Style></Border.Styles>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0" Text="⇄" FontSize="14" Foreground="#374151" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Input &amp; Output" FontSize="13" Foreground="#111827" Margin="10,0,0,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="›" FontSize="16" Foreground="#9CA3AF" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Border Padding="10,9" CornerRadius="6">
            <Border.Styles><Style Selector="Border:pointerover"><Setter Property="Background" Value="#F3F4F6"/></Style></Border.Styles>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0" Text="▤" FontSize="14" Foreground="#374151" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Data Sources" FontSize="13" Foreground="#111827" Margin="10,0,0,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="›" FontSize="16" Foreground="#9CA3AF" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Border Padding="10,9" CornerRadius="6">
            <Border.Styles><Style Selector="Border:pointerover"><Setter Property="Background" Value="#F3F4F6"/></Style></Border.Styles>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0" Text="🤖" FontSize="13" Foreground="#374151" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Models &amp; Agents" FontSize="13" Foreground="#111827" Margin="10,0,0,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="›" FontSize="16" Foreground="#9CA3AF" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Border Padding="10,9" CornerRadius="6">
            <Border.Styles><Style Selector="Border:pointerover"><Setter Property="Background" Value="#F3F4F6"/></Style></Border.Styles>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0" Text="⚙" FontSize="14" Foreground="#374151" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="LLM Operations" FontSize="13" Foreground="#111827" Margin="10,0,0,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="›" FontSize="16" Foreground="#9CA3AF" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Border Padding="10,9" CornerRadius="6">
            <Border.Styles><Style Selector="Border:pointerover"><Setter Property="Background" Value="#F3F4F6"/></Style></Border.Styles>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0" Text="▤" FontSize="14" Foreground="#374151" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Files" FontSize="13" Foreground="#111827" Margin="10,0,0,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="›" FontSize="16" Foreground="#9CA3AF" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Border Padding="10,9" CornerRadius="6">
            <Border.Styles><Style Selector="Border:pointerover"><Setter Property="Background" Value="#F3F4F6"/></Style></Border.Styles>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0" Text="▽" FontSize="13" Foreground="#374151" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Processing" FontSize="13" Foreground="#111827" Margin="10,0,0,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="›" FontSize="16" Foreground="#9CA3AF" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Border Padding="10,9" CornerRadius="6">
            <Border.Styles><Style Selector="Border:pointerover"><Setter Property="Background" Value="#F3F4F6"/></Style></Border.Styles>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0" Text="⇉" FontSize="14" Foreground="#374151" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Flow Control" FontSize="13" Foreground="#111827" Margin="10,0,0,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="›" FontSize="16" Foreground="#9CA3AF" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Border Padding="10,9" CornerRadius="6">
            <Border.Styles><Style Selector="Border:pointerover"><Setter Property="Background" Value="#F3F4F6"/></Style></Border.Styles>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0" Text="✦" FontSize="13" Foreground="#374151" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Utilities" FontSize="13" Foreground="#111827" Margin="10,0,0,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="›" FontSize="16" Foreground="#9CA3AF" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
