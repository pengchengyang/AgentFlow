<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AgentFlow.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:s="clr-namespace:AgentFlow.Services"
        mc:Ignorable="d"
        x:Class="AgentFlow.Views.ConfirmDialogWindow"
        x:DataType="vm:ConfirmDialogViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Title}"
        Width="380" Height="254"
        MinWidth="340" MinHeight="234"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Manual"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur"
        WindowDecorations="BorderOnly">
  <Border CornerRadius="0" Background="{DynamicResource BrushCard}"
          BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1"
          Padding="2"
          BoxShadow="0 20 60 0 #260F172A">
    <ExperimentalAcrylicBorder CornerRadius="0">
    <ExperimentalAcrylicBorder.Material>
        <ExperimentalAcrylicMaterial BackgroundSource="Digger" TintColor="#F0F0F0" TintOpacity="0.5" FallbackColor="#F9FAFB" MaterialOpacity="0.55"/>
    </ExperimentalAcrylicBorder.Material>
  <Grid RowDefinitions="34,*">
    <!-- Custom title bar (two buttons: minimize, close) -->
    <Border Grid.Row="0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
      <Border.Styles>
        <Style Selector="Button.winbtn">
          <Setter Property="Width" Value="32"/>
          <Setter Property="Height" Value="30"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="CornerRadius" Value="8"/>
          <Setter Property="HorizontalContentAlignment" Value="Center"/>
          <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.winbtn:pointerover">
          <Setter Property="Background" Value="#F3F4F6"/>
        </Style>
        <Style Selector="Button.winbtn:pressed">
          <Setter Property="Background" Value="#E5E7EB"/>
        </Style>
        <Style Selector="Button.winbtn.close:pointerover">
          <Setter Property="Background" Value="#E81123"/>
        </Style>
        <Style Selector="Button.winbtn.close:pointerover Path">
          <Setter Property="Fill" Value="White"/>
        </Style>

        <Style Selector="Button.winbtn.min">
          <Setter Property="Background" Value="{DynamicResource BrushMinBtnBg}"/>
        </Style>
        <Style Selector="Button.winbtn.min:pointerover">
          <Setter Property="Background" Value="{DynamicResource BrushMinBtnHoverBg}"/>
        </Style>
        <Style Selector="Button.winbtn.min:pressed">
          <Setter Property="Background" Value="{DynamicResource BrushMinBtnPressedBg}"/>
        </Style>
        <Style Selector="Button.winbtn.close">
          <Setter Property="Background" Value="{DynamicResource BrushCloseBtnBg}"/>
        </Style>
        <Style Selector="Button.winbtn.close:pointerover">
          <Setter Property="Background" Value="{DynamicResource BrushCloseBtnHoverBg}"/>
        </Style>
        <Style Selector="Button.winbtn.close:pressed">
          <Setter Property="Background" Value="{DynamicResource BrushCloseBtnPressedBg}"/>
        </Style>
        <Style Selector="Button.winbtn.close Path">
          <Setter Property="Fill" Value="{DynamicResource BrushCloseBtnFg}"/>
        </Style>
      </Border.Styles>
      <Grid ColumnDefinitions="*,Auto">
        <Border Grid.Column="0" Background="Transparent" PointerPressed="TitleBar_OnPointerPressed">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
            <Border Background="White" CornerRadius="0" Padding="6,4"
        BorderBrush="#A9C6F5" BorderThickness="1"
        VerticalAlignment="Center">
  <Path Data="M 11 110L 12 105L 73 105L 74 93L 79 84L 83 82L 113 82L 113 105L 75 105L 72 122L 66 128L 12 128L 11 111 Z M 0 63L 24 63L 25 63L 62 63L 63 49L 68 42L 73 40L 124 40L 124 64L 62 64L 62 75L 55 86L 0 86 Z M 11 44L 12 21L 50 21L 51 8L 57 0L 113 0L 113 1L 113 22L 51 22L 50 35L 45 43L 41 45 Z"
        Fill="{DynamicResource BrushAvaloniaBlue}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
</Border>
            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Classes="winbtn min" Click="MinimizeButton_Click" ToolTip.Tip="{Binding [Minimize], Source={x:Static s:Loc.Instance}}">
            <Grid Width="16" Height="16">
              <Border Width="11" Height="1.5" CornerRadius="1" Background="#0E7490"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <Button Classes="winbtn close" Click="CloseButton_Click" ToolTip.Tip="{Binding [Close], Source={x:Static s:Loc.Instance}}">
            <Grid Width="16" Height="16">
              <Path Data="M342.6 150.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L192 210.7 86.6 105.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L146.7 256 41.4 361.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L192 301.3 297.4 406.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L237.3 256 342.6 150.6z"
                    Stretch="Uniform" Width="12" Height="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Margin="0" Background="{DynamicResource BrushCard}">
      <DockPanel LastChildFill="True">
        <!-- Bottom buttons: Confirm is default (Enter confirms), Cancel cancels (Esc cancels) -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="20,14">
          <Border.Styles>
            <Style Selector="Button.toolbtn">
              <Setter Property="Width" Value="40"/>
              <Setter Property="Height" Value="36"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="CornerRadius" Value="8"/>
              <Setter Property="HorizontalContentAlignment" Value="Center"/>
              <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style Selector="Button.toolbtn:pointerover">
              <Setter Property="Background" Value="#F3F4F6"/>
            </Style>
            <Style Selector="Button.toolbtn:pressed">
              <Setter Property="Background" Value="#E5E7EB"/>
            </Style>

            <!-- Confirm: solid green + green icon -->
            <Style Selector="Button.toolbtn.success">
              <Setter Property="Background" Value="#DCFCE7"/>
            </Style>
            <Style Selector="Button.toolbtn.success:pointerover">
              <Setter Property="Background" Value="#BBF7D0"/>
            </Style>
            <Style Selector="Button.toolbtn.success:pressed">
              <Setter Property="Background" Value="#86EFAC"/>
            </Style>
            <Style Selector="Button.toolbtn.success Path">
              <Setter Property="Fill" Value="#15803D"/>
            </Style>
            <!-- Cancel: light gray background + dark icon -->
            <Style Selector="Button.toolbtn.cancel">
              <Setter Property="Background" Value="#F1F5F9"/>
            </Style>
            <Style Selector="Button.toolbtn.cancel:pointerover">
              <Setter Property="Background" Value="#E2E8F0"/>
            </Style>
            <Style Selector="Button.toolbtn.cancel:pressed">
              <Setter Property="Background" Value="#CBD5E1"/>
            </Style>
            <!-- Danger: light rose background + red icon -->
            <Style Selector="Button.toolbtn.danger">
              <Setter Property="Background" Value="#FEE2E2"/>
            </Style>
            <Style Selector="Button.toolbtn.danger:pointerover">
              <Setter Property="Background" Value="#FECACA"/>
            </Style>
            <Style Selector="Button.toolbtn.danger:pressed">
              <Setter Property="Background" Value="#FCA5A5"/>
            </Style>
            <Style Selector="Button.toolbtn.danger Path">
              <Setter Property="Fill" Value="#B91C1C"/>
            </Style>
          </Border.Styles>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Classes="toolbtn danger" Command="{Binding CancelCommand}" IsCancel="True" ToolTip.Tip="{Binding CancelText}">
              <Path Data="M256 48a208 208 0 1 1 0 416 208 208 0 1 1 0-416zm0 464a256 256 0 1 0 0-512 256 256 0 1 0 0 512zM167 167c-9.4 9.4-9.4 24.6 0 33.9l55 55-55 55c-9.4 9.4-9.4 24.6 0 33.9s24.6 9.4 33.9 0l55-55 55 55c9.4 9.4 24.6 9.4 33.9 0s9.4-24.6 0-33.9l-55-55 55-55c9.4-9.4 9.4-24.6 0-33.9s-24.6-9.4-33.9 0l-55 55-55-55c-9.4-9.4-24.6-9.4-33.9 0z"
                    Stretch="Uniform" Width="20" Height="20"/>
            </Button>
            <Button Classes="toolbtn success" Command="{Binding ConfirmCommand}" IsDefault="True" ToolTip.Tip="{Binding ConfirmText}">
              <Path Data="M256 512a256 256 0 1 1 0-512 256 256 0 1 1 0 512zm0-464a208 208 0 1 0 0 416 208 208 0 1 0 0-416zm70.7 121.9c7.8-10.7 22.8-13.1 33.5-5.3 10.7 7.8 13.1 22.8 5.3 33.5L243.4 366.1c-4.1 5.7-10.5 9.3-17.5 9.8-7 .5-13.9-2-18.8-6.9l-55.9-55.9c-9.4-9.4-9.4-24.6 0-33.9s24.6-9.4 33.9 0l36 36 105.6-145.2z"
                    Stretch="Uniform" Width="20" Height="20"/>
            </Button>
          </StackPanel>
        </Border>

        <!-- Prompt body -->
        <StackPanel Margin="20,20" Spacing="10" VerticalAlignment="Top">
          <Border Background="{DynamicResource BrushClearBg}" CornerRadius="6" Padding="9,9"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <Path Data="M136.7 5.9C141.1-7.2 153.3-16 167.1-16l113.9 0c13.8 0 26 8.8 30.4 21.9L320 32 416 32c17.7 0 32 14.3 32 32s-14.3 32-32 32L32 96C14.3 96 0 81.7 0 64S14.3 32 32 32l96 0 8.7-26.1zM32 144l384 0 0 304c0 35.3-28.7 64-64 64L96 512c-35.3 0-64-28.7-64-64l0-304zm88 64c-13.3 0-24 10.7-24 24l0 192c0 13.3 10.7 24 24 24s24-10.7 24-24l0-192c0-13.3-10.7-24-24-24zm104 0c-13.3 0-24 10.7-24 24l0 192c0 13.3 10.7 24 24 24s24-10.7 24-24l0-192c0-13.3-10.7-24-24-24zm104 0c-13.3 0-24 10.7-24 24l0 192c0 13.3 10.7 24 24 24s24-10.7 24-24l0-192c0-13.3-10.7-24-24-24z" Stretch="Uniform" Fill="{DynamicResource BrushClearFg}" Width="18" Height="18"/>
          </Border>
          <TextBlock Text="{Binding Message}" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
      </ExperimentalAcrylicBorder>
  </Border>
</Window>













