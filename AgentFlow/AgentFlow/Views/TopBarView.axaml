<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AgentFlow.ViewModels"
             xmlns:s="clr-namespace:AgentFlow.Services"
             x:Class="AgentFlow.Views.TopBarView"
             x:DataType="vm:TopBarViewModel">

  <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="Auto,*,Auto" Height="44">
      <!-- 左：空（工具栏在 MainView） -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center"/>

      <!-- 中：居中标题 -->
      <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="Starter Project" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center"/>
        <TextBlock Text="/" FontSize="13" Foreground="#D1D5DB" VerticalAlignment="Center"/>
        <Border Width="18" Height="18" CornerRadius="4" Background="#7C3AED" VerticalAlignment="Center">
          <TextBlock Text="◆" Foreground="White" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Basic Prompting" FontSize="13" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center"/>
      </StackPanel>

      <!-- 右：145k / 24k / 铃铛 / 头像 / ResetZoom / Share -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" Margin="0,0,14,0" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="🐙" FontSize="14" Foreground="#6B7280" VerticalAlignment="Center"/>
          <TextBlock Text="145k" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="💬" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center"/>
          <TextBlock Text="24k" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="🔔" FontSize="14" Foreground="#6B7280" VerticalAlignment="Center"/>
        <Border Width="26" Height="26" CornerRadius="13" Background="#7C3AED" VerticalAlignment="Center">
          <TextBlock Text="◆" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border Width="1" Height="20" Background="#E5E7EB" Margin="4,0"/>
        <Button Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8"
                Padding="12,6" FontSize="12" Foreground="#111827" Command="{Binding ResetZoomCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="📋" FontSize="12" VerticalAlignment="Center"/>
            <TextBlock Text="ResetZoom" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Background="#111827" CornerRadius="8" Padding="14,6" FontSize="12" BorderThickness="0" Command="{Binding OpenLoginCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Login" Foreground="White" VerticalAlignment="Center"/>

          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
