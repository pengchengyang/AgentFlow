<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AgentFlow.ViewModels"
             xmlns:s="clr-namespace:AgentFlow.Services"
             x:Class="AgentFlow.Views.LogPanelView"
             x:DataType="vm:MainViewModel">

  <!-- Bottom log panel -->
  <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
    <DockPanel Margin="10,6">
      <TextBlock DockPanel.Dock="Top" Text="{Binding [Log], Source={x:Static s:Loc.Instance}}"
                 FontWeight="SemiBold" FontSize="12" Foreground="#374151" Margin="2,0,2,4"/>
      <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="6,2">
        <ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0"
                 FontFamily="Consolas" FontSize="12"/>
      </Border>
    </DockPanel>
  </Border>
</UserControl>
