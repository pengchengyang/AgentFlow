<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AgentFlow.ViewModels"
             xmlns:s="clr-namespace:AgentFlow.Services"
             x:Class="AgentFlow.Views.LogPanelView"
             x:DataType="vm:MainViewModel">

  <!-- LangFlow 底部日志窄条 -->
  <Border Background="White"
          BorderBrush="#E5E7EB"
          BorderThickness="0,1,0,0"
          Height="120">
    <DockPanel Margin="12,8">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="2,0,0,6">
        <TextBlock Text="Logs" FontWeight="SemiBold" FontSize="12"
                   Foreground="#374151" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Classes="ghost" Content="Clear" FontSize="11" Padding="8,2"
                Command="{Binding ClearLogCommand}"/>
      </Grid>
      <Border Background="#F9FAFB" CornerRadius="6" Padding="8,4">
        <ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0"
                 FontFamily="Consolas" FontSize="11"/>
      </Border>
    </DockPanel>
  </Border>
</UserControl>
