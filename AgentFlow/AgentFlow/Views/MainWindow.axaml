<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgentFlow.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:AgentFlow.Views"
        xmlns:s="clr-namespace:AgentFlow.Services"
        xmlns:conv="clr-namespace:AgentFlow.Converters"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AgentFlow.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding [AppTitle], Source={x:Static s:Loc.Instance}}" WindowState="Maximized"
        TransparencyLevelHint="Transparent"
        Background="Transparent" WindowDecorations="None">
  <Window.Resources>
    <conv:InverseBoolConverter x:Key="InverseBool"/>
  </Window.Resources>

  <!-- Toolbar shortcuts: F1-F9 map to toolbar buttons left-to-right, F12 clears logs -->
  <Window.KeyBindings>
    <KeyBinding Gesture="F1" Command="{Binding Main.RunCommand}" />
    <KeyBinding Gesture="F2" Command="{Binding Main.StopCommand}" />
    <KeyBinding Gesture="F3" Command="{Binding Main.OpenCommand}" />
    <KeyBinding Gesture="F4" Command="{Binding Main.SaveCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding Main.SaveAsCommand}" />
    <KeyBinding Gesture="F6" Command="{Binding Main.ClearGraphCommand}" />
    <KeyBinding Gesture="F7" Command="{Binding Main.ResetZoomCommand}" />
    <KeyBinding Gesture="F8" Command="{Binding Main.OpenLoginCommand}" />
    <KeyBinding Gesture="F9" Command="{Binding Main.ToggleThemeCommand}" />
    <KeyBinding Gesture="F12" Command="{Binding Main.ClearLogCommand}" />
  </Window.KeyBindings>

  <!-- Floating window appearance: 16px outer corner radius (set to zero by code-behind when maximized) -->
	<Border x:Name="RootBorder"
			Background="{DynamicResource BrushCard}"
			BorderBrush="{DynamicResource BrushBorder}"
			BorderThickness="1"
			CornerRadius="8">
    <Grid RowDefinitions="34,*">
      <!-- Custom title bar (logo + title + version pill on the left, toolbar in the middle, window buttons on the right) -->
      <Border Grid.Row="0" Background="{DynamicResource BrushTitleBar}"
              BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="12,0,10,0">
          <!-- Left: gradient logo tile + title + version pill (draggable) -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                      Background="Transparent" VerticalAlignment="Center"
                      PointerPressed="TitleBar_OnPointerPressed">
            <Border Background="White" CornerRadius="0" Padding="6,4"
                    BorderBrush="#A9C6F5" BorderThickness="1"
                    VerticalAlignment="Center">
              <Path
                   Data="M 11 110 L 12 105 L 73 105 L 74 93 L 79 84 L 83 82 L 113 82 L 113 105 L 75 105 L 72 122 L 66 128 L 12 128 L 11 111 Z M 0 63 L 24 63 L 25 63 L 62 63 L 63 49 L 68 42 L 73 40 L 124 40 L 124 64 L 62 64 L 62 75 L 55 86 L 0 86 Z M 11 44 L 12 21 L 50 21 L 51 8 L 57 0 L 113 0 L 113 1 L 113 22 L 51 22 L 50 35 L 45 43 L 41 45 Z"
                   Fill="{DynamicResource BrushAvaloniaBlue}" Width="13" Height="13"
                   Stretch="Uniform" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{Binding [AppTitle], Source={x:Static s:Loc.Instance}}"
                       FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"
                       VerticalAlignment="Center"/>
          </StackPanel>

          <!-- Center: horizontal toolbar (order matches the design, with breathing room between icons) -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="22,0,0,0" VerticalAlignment="Center">
            <Button Classes="toolbtn run" Command="{Binding Main.RunCommand}"
                    ToolTip.Tip="{Binding [Run], Source={x:Static s:Loc.Instance}, StringFormat={}{0} (F1)}"
                    IsEnabled="{Binding Main.IsRunning, Converter={StaticResource InverseBool}}">
              <Path Data="M320 112C434.9 112 528 205.1 528 320C528 434.9 434.9 528 320 528C205.1 528 112 434.9 112 320C112 205.1 205.1 112 320 112zM320 576C461.4 576 576 461.4 576 320C576 178.6 461.4 64 320 64C178.6 64 64 178.6 64 320C64 461.4 178.6 576 320 576zM276.5 211.5C269.1 207 259.8 206.8 252.2 211C244.6 215.2 240 223.3 240 232L240 408C240 416.7 244.7 424.7 252.3 428.9C259.9 433.1 269.1 433 276.6 428.4L420.6 340.4C427.7 336 432.1 328.3 432.1 319.9C432.1 311.5 427.7 303.8 420.6 299.4L276.6 211.4zM362 320L288 365.2L288 274.8L362 320z" Stretch="Uniform" Width="12" Height="12"/>
            </Button>
            <!-- Stop: solid dark rounded square + white square -->
            <Button Classes="toolbtn dark" Command="{Binding Main.StopCommand}"
                    ToolTip.Tip="{Binding [Stop], Source={x:Static s:Loc.Instance}, StringFormat={}{0} (F2)}"
                    IsEnabled="{Binding Main.IsRunning}">
              <Path Data="M320 112C434.9 112 528 205.1 528 320C528 434.9 434.9 528 320 528C205.1 528 112 434.9 112 320C112 205.1 205.1 112 320 112zM320 576C461.4 576 576 461.4 576 320C576 178.6 461.4 64 320 64C178.6 64 64 178.6 64 320C64 461.4 178.6 576 320 576zM288 248C288 234.7 277.3 224 264 224C250.7 224 240 234.7 240 248L240 392C240 405.3 250.7 416 264 416C277.3 416 288 405.3 288 392L288 248zM400 248C400 234.7 389.3 224 376 224C362.7 224 352 234.7 352 248L352 392C352 405.3 362.7 416 376 416C389.3 416 400 405.3 400 392L400 248z" Stretch="Uniform" Width="12" Height="12"/>
            </Button>
            <!-- Open -->
            <Button Classes="toolbtn open" Command="{Binding Main.OpenCommand}"
                    ToolTip.Tip="{Binding [OpenWorkflow], Source={x:Static s:Loc.Instance}, StringFormat={}{0} (F3)}">
              <Path Data="M129.5 464L179.5 304L558.9 304L508.9 464L129.5 464zM320.2 512L509 512C530 512 548.6 498.4 554.8 478.3L604.8 318.3C614.5 287.4 591.4 256 559 256L179.6 256C158.6 256 140 269.6 133.8 289.7L112.2 358.4L112.2 160C112.2 151.2 119.4 144 128.2 144L266.9 144C270.4 144 273.7 145.1 276.5 147.2L314.9 176C328.7 186.4 345.6 192 362.9 192L480.2 192C489 192 496.2 199.2 496.2 208L544.2 208C544.2 172.7 515.5 144 480.2 144L362.9 144C356 144 349.2 141.8 343.7 137.6L305.3 108.8C294.2 100.5 280.8 96 266.9 96L128.2 96C92.9 96 64.2 124.7 64.2 160L64.2 448C64.2 483.3 92.9 512 128.2 512L320.2 512z" Stretch="Uniform" Width="12" Height="12" Fill="{DynamicResource BrushOpenFg}" VerticalAlignment="Center"/>
            </Button>
            <!-- Save -->
            <Button Classes="toolbtn save" Command="{Binding Main.SaveCommand}"
                    ToolTip.Tip="{Binding [Save], Source={x:Static s:Loc.Instance}, StringFormat={}{0} (F4)}">
              <Path Data="M160 144C151.2 144 144 151.2 144 160L144 480C144 488.8 151.2 496 160 496L480 496C488.8 496 496 488.8 496 480L496 237.3C496 233.1 494.3 229 491.3 226L416 150.6L416 240C416 257.7 401.7 272 384 272L224 272C206.3 272 192 257.7 192 240L192 144L160 144zM240 144L240 224L368 224L368 144L240 144zM96 160C96 124.7 124.7 96 160 96L402.7 96C419.7 96 436 102.7 448 114.7L525.3 192C537.3 204 544 220.3 544 237.3L544 480C544 515.3 515.3 544 480 544L160 544C124.7 544 96 515.3 96 480L96 160zM256 384C256 348.7 284.7 320 320 320C355.3 320 384 348.7 384 384C384 419.3 355.3 448 320 448C284.7 448 256 419.3 256 384z" Stretch="Uniform" Width="12" Height="12" Fill="{DynamicResource BrushSaveFg}"/>
            </Button>
            <!-- Save As -->
            <Button Classes="toolbtn save" Command="{Binding Main.SaveAsCommand}"
                    ToolTip.Tip="Save As (F5)">
              <Path Stretch="Uniform" Width="12" Height="12"
                    Stroke="{DynamicResource BrushSaveFg}"
                    StrokeThickness="1.5"
                    StrokeLineCap="Round">
                <Path.Data>
                  <GeometryGroup>
                    <!-- 文件轮廓 -->
                    <PathGeometry Figures="M12.5 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h10.2a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V12"/>
                    <!-- 另存为加号 -->
                    <PathGeometry Figures="M19 22v-6M22 19h-6"/>
                  </GeometryGroup>
                </Path.Data>
              </Path>
            </Button>
            <!-- Clear Canvas -->
            <Button Classes="toolbtn clear" Command="{Binding Main.ClearGraphCommand}"
                    ToolTip.Tip="{Binding [ClearCanvas], Source={x:Static s:Loc.Instance}, StringFormat={}{0} (F6)}">
              <Path Data="M136.7 5.9C141.1-7.2 153.3-16 167.1-16l113.9 0c13.8 0 26 8.8 30.4 21.9L320 32 416 32c17.7 0 32 14.3 32 32s-14.3 32-32 32L32 96C14.3 96 0 81.7 0 64S14.3 32 32 32l96 0 8.7-26.1zM32 144l384 0 0 304c0 35.3-28.7 64-64 64L96 512c-35.3 0-64-28.7-64-64l0-304zm88 64c-13.3 0-24 10.7-24 24l0 192c0 13.3 10.7 24 24 24s24-10.7 24-24l0-192c0-13.3-10.7-24-24-24zm104 0c-13.3 0-24 10.7-24 24l0 192c0 13.3 10.7 24 24 24s24-10.7 24-24l0-192c0-13.3-10.7-24-24-24zm104 0c-13.3 0-24 10.7-24 24l0 192c0 13.3 10.7 24 24 24s24-10.7 24-24l0-192c0-13.3-10.7-24-24-24z" Stretch="Uniform" Width="12" Height="12" Fill="{DynamicResource BrushClearFg}"/>
            </Button>
            <!-- Reset Zoom -->
            <Button Classes="toolbtn reset" Command="{Binding Main.ResetZoomCommand}"
                    ToolTip.Tip="{Binding [ResetZoom], Source={x:Static s:Loc.Instance}, StringFormat={}{0} (F7)}">
              <Path Data="M344 0L488 0c13.3 0 24 10.7 24 24l0 144c0 9.7-5.8 18.5-14.8 22.2s-19.3 1.7-26.2-5.2l-39-39-87 87c-9.4 9.4-24.6 9.4-33.9 0l-32-32c-9.4-9.4-9.4-24.6 0-33.9l87-87-39-39c-6.9-6.9-8.9-17.2-5.2-26.2S334.3 0 344 0zM168 512L24 512c-13.3 0-24-10.7-24-24L0 344c0-9.7 5.8-18.5 14.8-22.2S34.1 320.2 41 327l39 39 87-87c9.4-9.4 24.6-9.4 33.9 0l32 32c9.4 9.4 9.4 24.6 0 33.9l-87 87 39 39c6.9 6.9 8.9 17.2 5.2 26.2S177.7 512 168 512z" Stretch="Uniform" Width="12" Height="12" Fill="{DynamicResource BrushResetFg}"/>
            </Button>
            <!-- Login -->
            <Button Classes="toolbtn login" Command="{Binding Main.OpenLoginCommand}"
                    ToolTip.Tip="{Binding [Login], Source={x:Static s:Loc.Instance}, StringFormat={}{0} (F8)}">
              <Path Data="M224 248a120 120 0 1 0 0-240 120 120 0 1 0 0 240zm-29.7 56C95.8 304 16 383.8 16 482.3 16 498.7 29.3 512 45.7 512l356.6 0c16.4 0 29.7-13.3 29.7-29.7 0-98.5-79.8-178.3-178.3-178.3l-59.4 0z" Stretch="Uniform" Width="12" Height="12" Fill="{DynamicResource BrushLoginFg}"/>
            </Button>
            <!-- Theme toggle -->
            <Button Classes="toolbtn theme" Command="{Binding Main.ToggleThemeCommand}"
                    ToolTip.Tip="Toggle Theme (F9)">
              <Path Data="M12 8a4 4 0 1 0 0 8 4 4 0 1 0 0-8zM12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
                    Stretch="Uniform" Width="12" Height="12" Stroke="{DynamicResource BrushThemeBtnFg}" StrokeThickness="2" Fill="Transparent"/>
            </Button>
          </StackPanel>

          <!-- Draggable blank area -->
          <Border Grid.Column="2" Background="Transparent" PointerPressed="TitleBar_OnPointerPressed"/>

          <!-- Right: window buttons -->
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Border Background="#F5F3FF" CornerRadius="8" Padding="7,3"
                    VerticalAlignment="Center" Margin="0,0,14,0">
              <TextBlock Text="{Binding Version}" FontSize="10"
                         Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
            </Border>
            <Button Classes="winbtn min" Click="MinimizeButton_Click" ToolTip.Tip="{Binding [Minimize], Source={x:Static s:Loc.Instance}}">
              <Border Width="14" Height="1.5" CornerRadius="1"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <Button Classes="winbtn max" Click="MaxRestoreButton_Click" ToolTip.Tip="{Binding [Maximize], Source={x:Static s:Loc.Instance}}">
              <Grid Width="15" Height="15">
                <Path x:Name="MaximizeIcon"
                      Data="M0 128C0 92.7 28.7 64 64 64l384 0c35.3 0 64 28.7 64 64l0 256c0 35.3-28.7 64-64 64L64 448c-35.3 0-64-28.7-64-64L0 128zM64 112c-8.8 0-16 7.2-16 16l0 256c0 8.8 7.2 16 16 16l384 0c8.8 0 16-7.2 16-16l0-256c0-8.8-7.2-16-16-16L64 112z"
                      Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Path x:Name="RestoreIcon"
                      Data="M512 80L224 80c-8.8 0-16 7.2-16 16l0 16-48 0 0-16c0-35.3 28.7-64 64-64l288 0c35.3 0 64 28.7 64 64l0 192c0 35.3-28.7 64-64 64l-48 0 0-48 48 0c8.8 0 16-7.2 16-16l0-192c0-8.8-7.2-16-16-16zM368 288l-320 0 0 128c0 8.8 7.2 16 16 16l288 0c8.8 0 16-7.2 16-16l0-128zM64 160l288 0c35.3 0 64 28.7 64 64l0 192c0 35.3-28.7 64-64 64L64 480c-35.3 0-64-28.7-64-64L0 224c0-35.3 28.7-64 64-64z"
                      Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"/>
              </Grid>
            </Button>
            <Button Classes="winbtn close" Click="CloseButton_Click" ToolTip.Tip="{Binding [Close], Source={x:Static s:Loc.Instance}}">
              <Path Data="M342.6 150.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L192 210.7 86.6 105.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L146.7 256 41.4 361.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L192 301.3 297.4 406.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L237.3 256 342.6 150.6z"
                    Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <views:MainView Grid.Row="1" DataContext="{Binding Main}" />
    </Grid>
  </Border>
</Window>




