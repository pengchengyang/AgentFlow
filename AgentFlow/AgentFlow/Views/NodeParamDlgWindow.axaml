<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AgentFlow.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:s="clr-namespace:AgentFlow.Services"
        mc:Ignorable="d"
        x:Class="AgentFlow.Views.NodeParamDlgWindow"
        x:DataType="vm:NodeParamDlgViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding DialogTitle}"
        Width="800" Height="600"
        MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Manual"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None">
  <Border CornerRadius="0" Background="#F9FAFB" BorderBrush="#6B7280" BorderThickness="1">
    <Grid RowDefinitions="34,*,Auto">

      <!-- 自定义标题栏（项目统一风格） -->
      <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
        <Border.Styles>
          <Style Selector="Button.winbtn">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
          </Style>
          <Style Selector="Button.winbtn:pointerover">
            <Setter Property="Background" Value="#F3F4F6"/>
          </Style>
          <Style Selector="Button.winbtn:pressed">
            <Setter Property="Background" Value="#E5E7EB"/>
          </Style>
          <Style Selector="Button.winbtn.close:pointerover">
            <Setter Property="Background" Value="#E81123"/>
          </Style>
          <Style Selector="Button.winbtn.close:pointerover Path">
            <Setter Property="Fill" Value="White"/>
          </Style>
        </Border.Styles>
        <Grid ColumnDefinitions="*,Auto">
          <Border Grid.Column="0" Background="Transparent" PointerPressed="TitleBar_OnPointerPressed">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
              <Image Source="/Assets/avalonia-logo.ico" Width="16" Height="16" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Caption}" FontSize="13" FontWeight="SemiBold" Foreground="#374151" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Classes="winbtn" Click="MinimizeButton_Click" ToolTip.Tip="{Binding [Minimize], Source={x:Static s:Loc.Instance}}">
              <Grid Width="20" Height="20">
                <Border Width="14" Height="2" CornerRadius="1" Background="#111827"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button Classes="winbtn" Click="MaxRestoreButton_Click" ToolTip.Tip="{Binding [Maximize], Source={x:Static s:Loc.Instance}}">
              <Grid Width="22" Height="22">
                <Path x:Name="MaximizeIcon"
                      Data="M48 224l0 160c0 8.8 7.2 16 16 16l384 0c8.8 0 16-7.2 16-16l0-160-416 0zM0 128C0 92.7 28.7 64 64 64l384 0c35.3 0 64 28.7 64 64l0 256c0 35.3-28.7 64-64 64L64 448c-35.3 0-64-28.7-64-64L0 128z"
                      Stretch="Uniform" Fill="#111827" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Path x:Name="RestoreIcon"
                      Data="M512 80L224 80c-8.8 0-16 7.2-16 16l0 16-48 0 0-16c0-35.3 28.7-64 64-64l288 0c35.3 0 64 28.7 64 64l0 192c0 35.3-28.7 64-64 64l-48 0 0-48 48 0c8.8 0 16-7.2 16-16l0-192c0-8.8-7.2-16-16-16zM368 288l-320 0 0 128c0 8.8 7.2 16 16 16l288 0c8.8 0 16-7.2 16-16l0-128zM64 160l288 0c35.3 0 64 28.7 64 64l0 192c0 35.3-28.7 64-64 64L64 480c-35.3 0-64-28.7-64-64L0 224c0-35.3 28.7-64 64-64z"
                      Stretch="Uniform" Fill="#111827" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"/>
              </Grid>
            </Button>
            <Button Classes="winbtn close" Click="CloseButton_Click" ToolTip.Tip="{Binding [Close], Source={x:Static s:Loc.Instance}}">
              <Grid Width="20" Height="20">
                <Path Data="M64 112c-8.8 0-16 7.2-16 16l0 256c0 8.8 7.2 16 16 16l384 0c8.8 0 16-7.2 16-16l0-256c0-8.8-7.2-16-16-16L64 112zM0 128C0 92.7 28.7 64 64 64l384 0c35.3 0 64 28.7 64 64l0 256c0 35.3-28.7 64-64 64L64 448c-35.3 0-64-28.7-64-64L0 128zm334.1 49.9c9.4 9.4 9.4 24.6 0 33.9l-44.1 44.1 44.1 44.1c9.4 9.4 9.4 24.6 0 33.9s-24.6 9.4-33.9 0l-44.1-44.1-44.1 44.1c-9.4 9.4-24.6 9.4-33.9 0s-9.4-24.6 0-33.9l44.1-44.1-44.1-44.1c-9.4-9.4-9.4-24.6 0-33.9s24.6-9.4 33.9 0l44.1 44.1 44.1-44.1c9.4-9.4 24.6-9.4 33.9 0z"
                      Stretch="Uniform" Fill="#111827" Width="20" Height="20"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 主体：矩形1(Zone) + 间隔 + 矩形2(Group + 底部描述区) -->
      <Grid Grid.Row="1" Margin="12" ColumnDefinitions="180,12,*">

        <!-- 矩形1：Zone 导航列表 -->
        <Border Grid.Column="0" Background="White" BorderBrush="#D1D5DB" BorderThickness="1">
          <ListBox ItemsSource="{Binding Zones}"
                   SelectedItem="{Binding SelectedZone, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0" Padding="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
              </Style>
              <Style Selector="ListBoxItem /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Padding" Value="0"/>
              </Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#F3F4F6"/>
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="#E5E7EB"/>
              </Style>
              <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#E5E7EB"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ParameterZoneNode}" x:DataType="vm:ParameterZoneNode">
                <TextBlock Text="{Binding Name}" Margin="14,7"
                           FontSize="12" Foreground="#374151" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <!-- 矩形1 与 矩形2 之间的间隔列 -->

        <!-- 矩形2：选中 zone 下的 group（可收起）+ 参数行 + 底部描述区 -->
        <Border Grid.Column="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1">
          <Grid RowDefinitions="*,Auto">

            <!-- 上方：group 列表 + 空状态 -->
            <Grid Grid.Row="0">
              <TextBlock Text="{Binding [NoParameters], Source={x:Static s:Loc.Instance}}"
                         IsVisible="{Binding HasNoParameters}"
                         Foreground="#9CA3AF" FontSize="12"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>

              <ListBox ItemsSource="{Binding VisibleItems}"
                       SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                       Background="Transparent" BorderThickness="0" Padding="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="CornerRadius" Value="0"/>
                    <Setter Property="Focusable" Value="False"/>
                  </Style>
                  <Style Selector="ListBoxItem /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="CornerRadius" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                  </Style>
                  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                  </Style>
                  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                  </Style>
                  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                  </Style>

                  <Style Selector="Border.groupHeader">
                    <Setter Property="Background" Value="#F3F4F6"/>
                    <Setter Property="BorderBrush" Value="#E5E7EB"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="Padding" Value="10,7"/>
                  </Style>
                  <Style Selector="Button.groupToggle">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="CornerRadius" Value="0"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="Cursor" Value="Hand"/>
                  </Style>
                  <Style Selector="Button.groupToggle:pointerover">
                    <Setter Property="Background" Value="Transparent"/>
                  </Style>
                  <Style Selector="Button.groupToggle:pressed">
                    <Setter Property="Background" Value="Transparent"/>
                  </Style>
                  <Style Selector="Button.groupToggle /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                  </Style>
                  <Style Selector="Button.groupToggle:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                  </Style>
                  <Style Selector="Button.groupToggle:pressed /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                  </Style>

                  <Style Selector="Border.propRow">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="MinHeight" Value="28"/>
                  </Style>
                  <Style Selector="Border.propRow.hover">
                    <Setter Property="Background" Value="#F3F4F6"/>
                  </Style>
                  <Style Selector="Border.propRow.selected">
                    <Setter Property="Background" Value="#E5E7EB"/>
                  </Style>
                  <Style Selector="Border.propRow.selected TextBlock.propName">
                    <Setter Property="Foreground" Value="#111827"/>
                  </Style>
                  <Style Selector="Border.propRow.selected TextBlock.propValue">
                    <Setter Property="Foreground" Value="#111827"/>
                  </Style>
                  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                    <Setter Property="BorderBrush" Value="Black"/>
                  </Style>
                </ListBox.Styles>

                <ListBox.DataTemplates>
                  <DataTemplate DataType="{x:Type vm:ParameterGroupNode}" x:DataType="vm:ParameterGroupNode">
                    <Border Classes="groupHeader">
                      <Button Classes="groupToggle" Command="{Binding ToggleCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Path Data="M297.4 438.6C309.9 451.1 330.2 451.1 342.7 438.6L502.7 278.6C515.2 266.1 515.2 245.8 502.7 233.3C490.2 220.8 469.9 220.8 457.4 233.3L320 370.7L182.6 233.4C170.1 220.9 149.8 220.9 137.3 233.4C124.8 245.9 124.8 266.2 137.3 278.7L297.3 438.7z"
                                            Stretch="Uniform" Fill="#6B7280" Width="14" Height="14"
                                            VerticalAlignment="Center" Margin="0,2,0,0" IsVisible="{Binding IsExpanded}"/>
                          <Path Data="M247.1 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L179.2 256 41.9 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"
                                            Stretch="Uniform" Fill="#6B7280" Width="14" Height="14"
                                            VerticalAlignment="Center" IsVisible="{Binding !IsExpanded}"/>
                          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                     Foreground="#111827" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                    </Border>
                  </DataTemplate>

                  <DataTemplate DataType="{x:Type vm:ParameterEditRow}" x:DataType="vm:ParameterEditRow">
                    <Border Classes="propRow"
                            Classes.selected="{Binding $parent[ListBoxItem].IsSelected}"
                            Classes.hover="{Binding $parent[ListBoxItem].IsPointerOver}">
                      <Grid ColumnDefinitions="180,*">
                        <TextBlock Classes="propName" Grid.Column="0"
                                   Text="{Binding Label}" Margin="24,0,8,0"
                                   FontSize="12" Foreground="#374151"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Panel Grid.Column="1">
                          <TextBox Text="{Binding Value, Mode=TwoWay}"
                                   IsVisible="{Binding IsEditable}"
                                   FontSize="12" Padding="6,2" Margin="0,2,8,2"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                   VerticalContentAlignment="Center"/>
                          <TextBlock Classes="propValue" Text="{Binding Value}"
                                     IsVisible="{Binding !IsEditable}"
                                     FontSize="12" Foreground="#6B7280"
                                     Margin="6,0,8,0"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Panel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.DataTemplates>
              </ListBox>
            </Grid>

            <!-- 下方：描述区（放入矩形2内部底部） -->
            <Border Grid.Row="1" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                    MinHeight="64" Padding="14,10">
              <StackPanel Spacing="4" VerticalAlignment="Top">
                <TextBlock Text="{Binding DetailTitle}" FontSize="13" FontWeight="SemiBold" Foreground="#111827"/>
                <TextBlock Text="{Binding DetailDescription}" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <!-- 底部按钮栏 -->
      <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="14,10">
        <Border.Styles>
          <Style Selector="Button.dlgbtn">
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
          </Style>
          <Style Selector="Button.dlgbtn:pointerover">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#9CA3AF"/>
          </Style>
          <Style Selector="Button.dlgbtn:pressed">
            <Setter Property="Background" Value="#E5E7EB"/>
          </Style>
          <Style Selector="Button.dlgbtn.primary">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="Black"/>
          </Style>
          <Style Selector="Button.dlgbtn.primary:pointerover">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="BorderBrush" Value="Black"/>
          </Style>
        </Border.Styles>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Classes="dlgbtn primary"
                  Content="{Binding [OK], Source={x:Static s:Loc.Instance}}"
                  Command="{Binding ConfirmCommand}"/>
          <Button Classes="dlgbtn"
                  Content="{Binding [Cancel], Source={x:Static s:Loc.Instance}}"
                  Command="{Binding CancelCommand}"/>
          <Button Classes="dlgbtn"
                  Content="{Binding [Apply], Source={x:Static s:Loc.Instance}}"
                  Command="{Binding ApplyCommand}"
                  IsEnabled="{Binding CanApply}"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
