<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AgentFlow.Views"
             x:Class="AgentFlow.Views.CanvasView">
  <!--
    纯 Avalonia Canvas：节点、pin、连线全部由 GraphCanvas.Render 用 DrawingContext 自绘，
    不依赖 Nodify，也没有声明式的 Ellipse / Path 元素。pin 圆点和贝塞尔曲线完全自绘。
  -->
  <views:GraphCanvas/>
</UserControl>
