<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AgentFlow.ViewModels"
             xmlns:c="clr-namespace:AgentFlow.Views"
             xmlns:s="clr-namespace:AgentFlow.Services"
             xmlns:nodify="clr-namespace:Nodify.Avalonia;assembly=Nodify.Avalonia"
             xmlns:nodes="clr-namespace:Nodify.Avalonia.Nodes;assembly=Nodify.Avalonia"
             xmlns:conn="clr-namespace:Nodify.Avalonia.Connections;assembly=Nodify.Avalonia"
             x:Class="AgentFlow.Views.CanvasView"
             x:DataType="vm:MainViewModel">

  <UserControl.Resources>
    <!-- LangFlow 点阵背景 -->
    <VisualBrush x:Key="DotsBrush" TileMode="Tile" Stretch="None" DestinationRect="0,0,20,20">
      <VisualBrush.Visual>
        <Canvas Width="20" Height="20">
          <Ellipse Canvas.Left="9" Canvas.Top="9" Width="2" Height="2" Fill="#DDE3EA"/>
        </Canvas>
      </VisualBrush.Visual>
    </VisualBrush>

  </UserControl.Resources>

  <Grid Background="#F4F5F8" DragDrop.AllowDrop="True" DragDrop.Drop="OnCanvasDrop">
    <nodify:NodifyEditor x:Name="Editor" Background="{StaticResource DotsBrush}"
                         ItemsSource="{Binding Nodes}"
                         Connections="{Binding Connections}"
                         SelectedConnections="{Binding SelectedConnections}"
                         PendingConnection="{Binding PendingConnection}"
                         ConnectionStartedCommand="{Binding ConnectionStartedCommand}"
                         ConnectionCompletedCommand="{Binding ConnectionCompletedCommand}">

      <nodify:NodifyEditor.KeyBindings>
        <KeyBinding Gesture="Delete"
                   Command="{Binding DeleteSelectionCommand}"/>
      </nodify:NodifyEditor.KeyBindings>

      <nodify:NodifyEditor.ItemContainerTheme>
        <ControlTheme TargetType="nodify:ItemContainer" BasedOn="{StaticResource {x:Type nodify:ItemContainer}}" x:DataType="vm:NodeViewModel">
          <Setter Property="Location" Value="{Binding Location}"/>
          <Setter Property="IsSelected" Value="{Binding IsSelected}"/>
        </ControlTheme>
      </nodify:NodifyEditor.ItemContainerTheme>

      <nodify:NodifyEditor.ItemTemplate>
        <DataTemplate DataType="vm:NodeViewModel">
          <!-- 节点卡片：ClipToBounds=False 让 Pin 圆点突出卡片边缘 -->
          <Border Background="White" CornerRadius="12" MinWidth="280"
                  ClipToBounds="False"
                  BorderBrush="#E5E7EB" BorderThickness="1"
                  BoxShadow="0 4 16 0 #14000000">
            <Border.ContextMenu>
              <ContextMenu>
                <MenuItem Header="删除节点" Foreground="#DC2626"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveNodeCommand}"
                          CommandParameter="{Binding}"/>
              </ContextMenu>
            </Border.ContextMenu>

            <Grid ClipToBounds="False">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ClipToBounds="False">

                <!-- 头部：图标 + 标题 + 播放三角 -->
                <Border Grid.Row="0" Padding="16,14,14,8">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="▷" FontSize="13"
                               Foreground="#9CA3AF" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="◆" FontSize="15" Foreground="{Binding Accent}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                 Foreground="#111827" VerticalAlignment="Center"/>
                    </StackPanel>
                  </DockPanel>
                </Border>

                <!-- 描述 -->
                <Border Grid.Row="1" Padding="16,0,16,10">
                  <TextBlock Text="{Binding TypeId}" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"/>
                </Border>

                <!-- 分隔线 -->
                <Border Grid.Row="2" Height="1" Background="#F3F4F6" Margin="16,0"/>

                <!-- 输入端口：每行一个左缘 Pin + 端口名 -->
                <ItemsControl Grid.Row="3" ItemsSource="{Binding Inputs}" IsVisible="{Binding HasInputs}"
                              Padding="16,6,16,2" ClipToBounds="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:PinViewModel">
                      <Grid Height="30" ClipToBounds="False">
                        <!-- 输入 Pin：圆心落在卡片左边线上 -->
                        <Grid Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="-25,0,0,0" ClipToBounds="False">
                          <!-- pin：统一紫色实心圆点（输入/输出一致） -->
                          <Ellipse Width="11" Height="11" Fill="#8B5CF6"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <!-- 交互层（透明命中区，负责拖拽建连 + 上报 Anchor） -->
                          <nodes:NodeInput Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                           IsConnected="{Binding IsConnected, Mode=OneWay}"
                                           Width="18" Height="18" Background="Transparent"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Grid>
                        <!-- 端口名（必填显示红色 *） -->
                        <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" Foreground="#111827"/>
                          <TextBlock Text="*" FontSize="12" Foreground="#EF4444" Margin="2,0,0,0"
                                     IsVisible="{Binding Required}"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 参数区：可编辑框 -->
                <ItemsControl Grid.Row="4" ItemsSource="{Binding Parameters}" IsVisible="{Binding HasParameters}"
                              Padding="16,8,16,6">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ParameterViewModel">
                      <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Medium"
                                   Foreground="#111827" Margin="0,0,0,6" ToolTip.Tip="{Binding Hint}"/>
                        <TextBox Text="{Binding Value, Mode=TwoWay}" FontSize="12"
                                 Background="#F3F4F6" BorderThickness="0" CornerRadius="6" Padding="10,8"
                                 PlaceholderText="Value"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 底部输出条：右缘 Pin -->
                <Border Grid.Row="5" Background="#F3F4F6" CornerRadius="0,0,12,12"
                        IsVisible="{Binding HasOutputs}" ClipToBounds="False" Padding="16,8,16,8">
                  <ItemsControl ItemsSource="{Binding Outputs}" ClipToBounds="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:PinViewModel">
                        <Grid Height="28" ColumnDefinitions="*,Auto,Auto" ClipToBounds="False">
                          <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" FontWeight="Medium"
                                     Foreground="#111827" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                          <TextBlock Grid.Column="1" Text="☰" FontSize="11" Foreground="#9CA3AF"
                                     VerticalAlignment="Center" Margin="10,0,12,0"/>
                          <!-- pin：统一紫色实心圆点，圆心压在卡片右边线上 -->
                          <Grid Grid.Column="2" Width="18" Height="18" VerticalAlignment="Center"
                                Margin="0,0,-25,0" ClipToBounds="False">
                            <Ellipse Width="11" Height="11" Fill="#8B5CF6"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <nodes:NodeOutput Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                              IsConnected="{Binding IsConnected, Mode=OneWay}"
                                              Width="18" Height="18" Background="Transparent"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                          </Grid>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </Grid>

              <!-- 选中描边 -->
              <Border BorderBrush="#4F46E5" BorderThickness="2" CornerRadius="12"
                      Background="Transparent" IsHitTestVisible="False" IsVisible="{Binding IsSelected}"/>
            </Grid>
          </Border>
        </DataTemplate>
      </nodify:NodifyEditor.ItemTemplate>

      <!-- 连线：LangFlow 风格深灰平滑贝塞尔，无箭头 -->
      <nodify:NodifyEditor.ConnectionTemplate>
        <DataTemplate DataType="vm:ConnectionViewModel">
          <conn:Connection Source="{Binding Source.Anchor}"
                           Target="{Binding Target.Anchor}"
                           Stroke="#3F3F46" StrokeThickness="1.8"
                           ArrowEnds="None"
                           Spacing="60"
                           SourceOffsetMode="None" TargetOffsetMode="None"
                           DisconnectCommand="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveConnectionCommand}"/>
        </DataTemplate>
      </nodify:NodifyEditor.ConnectionTemplate>

    </nodify:NodifyEditor>
  </Grid>
</UserControl>
