<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AgentFlow.ViewModels"
             xmlns:s="clr-namespace:AgentFlow.Services"
             xmlns:nodify="clr-namespace:Nodify.Avalonia;assembly=Nodify.Avalonia"
             xmlns:nodes="clr-namespace:Nodify.Avalonia.Nodes;assembly=Nodify.Avalonia"
             xmlns:conn="clr-namespace:Nodify.Avalonia.Connections;assembly=Nodify.Avalonia"
             x:Class="AgentFlow.Views.CanvasView"
             x:DataType="vm:MainViewModel">

  <UserControl.Resources>
    <!-- LangFlow dotted canvas background -->
    <VisualBrush x:Key="DotsBrush" TileMode="Tile" Stretch="None" DestinationRect="0,0,22,22">
      <VisualBrush.Visual>
        <Canvas Width="22" Height="22">
          <Ellipse Canvas.Left="10" Canvas.Top="10" Width="2" Height="2" Fill="#C9CEDA"/>
        </Canvas>
      </VisualBrush.Visual>
    </VisualBrush>

    <!-- Override the default straight dashed pending-connection with a smooth cubic bezier,
         matching the solid connection below. -->
    <ControlTheme x:Key="{x:Type conn:PendingConnection}" TargetType="conn:PendingConnection">
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="StrokeThickness" Value="3"/>
      <Setter Property="StrokeDashArray" Value="5,5"/>
      <Setter Property="Stroke" Value="#7C3AED"/>
      <Setter Property="IsVisible" Value="False"/>
      <Setter Property="ClipToBounds" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="conn:PendingConnection">
            <Canvas>
              <conn:Connection Source="{TemplateBinding SourceAnchor}"
                               Target="{TemplateBinding TargetAnchor}"
                               Stroke="{TemplateBinding Stroke}"
                               StrokeThickness="{TemplateBinding StrokeThickness}"
                               StrokeDashArray="{TemplateBinding StrokeDashArray}"
                               Direction="{TemplateBinding Direction}"
                               Spacing="0"
                               SourceOffsetMode="None" TargetOffsetMode="None"/>
            </Canvas>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </ControlTheme>
  </UserControl.Resources>
  <Grid Background="#F4F5F8" DragDrop.AllowDrop="True" DragDrop.Drop="OnCanvasDrop">
    <nodify:NodifyEditor x:Name="Editor" Background="{StaticResource DotsBrush}"
                         ItemsSource="{Binding Nodes}"
                         Connections="{Binding Connections}"
                         ConnectionCompletedCommand="{Binding ConnectionCompletedCommand}"
                         GridCellSize="22">

      <nodify:NodifyEditor.ItemContainerTheme>
        <ControlTheme TargetType="nodify:ItemContainer" BasedOn="{StaticResource {x:Type nodify:ItemContainer}}" x:DataType="vm:NodeViewModel">
          <Setter Property="Location" Value="{Binding Location}"/>
          <Setter Property="IsSelected" Value="{Binding IsSelected}"/>
        </ControlTheme>
      </nodify:NodifyEditor.ItemContainerTheme>

      <!-- LangFlow node card: white rounded card, tinted header, left input pins / right output pins -->
      <nodify:NodifyEditor.ItemTemplate>
        <DataTemplate DataType="vm:NodeViewModel">
          <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                  CornerRadius="12" MinWidth="200"
                  BoxShadow="0 2 8 0 #14000000">
            <Border.Styles>
              <Style Selector="Border:pointerover">
                <Setter Property="BorderBrush" Value="#C4B5FD"/>
              </Style>
            </Border.Styles>
            <Grid RowDefinitions="Auto,*">

              <!-- Header: category tint + icon + title + delete button -->
              <Border Grid.Row="0" Background="{Binding AccentTint}" CornerRadius="12,12,0,0" Padding="12,8">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="✕" FontSize="10" Padding="5,1"
                          Background="Transparent" BorderThickness="0" Foreground="#B91C1C"
                          VerticalAlignment="Center"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveNodeCommand}"
                          CommandParameter="{Binding}"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="20" Height="20" CornerRadius="6" Background="{Binding Accent}" VerticalAlignment="Center">
                      <TextBlock Text="◆" Foreground="White" FontSize="9"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="#1F2937"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </DockPanel>
              </Border>

              <!-- Pin area: inputs on the left column, outputs on the right column.
                   Connectors use the built-in template (guaranteed hit-testing and anchor tracking);
                   a colored ring is drawn around each connector via a surrounding Border. -->
              <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="4,10,4,12">
                <StackPanel Grid.Column="0" Spacing="8">
                  <ItemsControl ItemsSource="{Binding Inputs}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:PinViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,0,0,0">
                          <Border Width="15" Height="15" CornerRadius="8" Background="White"
                                  BorderBrush="{Binding Node.Accent}" BorderThickness="2"
                                  VerticalAlignment="Center">
                            <nodes:NodeInput Anchor="{Binding Anchor, Mode=OneWayToSource}" IsConnected="True"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#374151"/>
                            <TextBlock Text="{Binding TypeName}" FontSize="9" Foreground="#9CA3AF"/>
                          </StackPanel>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Right">
                  <ItemsControl ItemsSource="{Binding Outputs}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:PinViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,4,0">
                          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#374151" TextAlignment="Right"/>
                            <TextBlock Text="{Binding TypeName}" FontSize="9" Foreground="#9CA3AF" TextAlignment="Right"/>
                          </StackPanel>
                          <Border Width="15" Height="15" CornerRadius="8" Background="{Binding Node.Accent}"
                                  BorderBrush="White" BorderThickness="2"
                                  VerticalAlignment="Center">
                            <nodes:NodeOutput Anchor="{Binding Anchor, Mode=OneWayToSource}" IsConnected="True"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </DataTemplate>
      </nodify:NodifyEditor.ItemTemplate>

      <nodify:NodifyEditor.ConnectionTemplate>
        <DataTemplate DataType="vm:ConnectionViewModel">
          <conn:Connection Source="{Binding Source.Anchor}"
                           Target="{Binding Target.Anchor}"
                           Stroke="#7C3AED" StrokeThickness="2" Spacing="40"
                           DisconnectCommand="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveConnectionCommand}"/>
        </DataTemplate>
      </nodify:NodifyEditor.ConnectionTemplate>

    </nodify:NodifyEditor>
  </Grid>
</UserControl>

