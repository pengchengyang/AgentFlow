<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AgentFlow.Views"
             x:Class="AgentFlow.Views.CanvasView">
  <!--
    Pure Avalonia Canvas: nodes, pins and connections are all drawn by GraphCanvas.Render with DrawingContext,
    with no Nodify dependency and no declarative Ellipse / Path elements. Pin dots and bezier curves are fully self-drawn.
  -->
  <views:GraphCanvas/>
</UserControl>
