<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AgentFlow.ViewModels"
             xmlns:s="clr-namespace:AgentFlow.Services"
             x:Class="AgentFlow.Views.InspectorView"
             x:DataType="vm:MainViewModel">

  <!-- LangFlow right-hand property panel -->
  <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1,0,0,0">
    <DockPanel Margin="12">
      <TextBlock DockPanel.Dock="Top" Text="{Binding [Properties], Source={x:Static s:Loc.Instance}}"
                 FontWeight="SemiBold" FontSize="14" Foreground="#1F2937" Margin="2,2,2,8"/>
      <ScrollViewer>
        <StackPanel DataContext="{Binding SelectedNode}" Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="20" Height="20" CornerRadius="6" Background="{Binding Accent}" VerticalAlignment="Center">
              <TextBlock Text="◆" Foreground="White" FontSize="9"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#1F2937"
                       VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="{Binding TypeId}" FontSize="11" Foreground="#9CA3AF"/>
          <Border Height="1" Background="#E5E7EB" Margin="0,4"/>
          <TextBlock Text="{Binding [Parameters], Source={x:Static s:Loc.Instance}}"
                     FontWeight="SemiBold" Foreground="#374151" FontSize="12"/>
          <ItemsControl ItemsSource="{Binding Parameters}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ParameterViewModel">
                <StackPanel Margin="0,2">
                  <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#6B7280" ToolTip.Tip="{Binding Hint}"/>
                  <TextBox Text="{Binding Value}" CornerRadius="6" Margin="0,2,0,0" Padding="8,5"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
