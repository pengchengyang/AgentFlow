<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AgentFlow.ViewModels"
             xmlns:s="clr-namespace:AgentFlow.Services"
             xmlns:conv="clr-namespace:AgentFlow.Converters"
             x:Class="AgentFlow.Views.NodeLibraryView"
             x:DataType="vm:NodeLibraryViewModel">

  <UserControl.Resources>
    <conv:NotEmptyConverter x:Key="NotEmpty"/>
    <conv:LastWordInitialConverter x:Key="Initial"/>
    <conv:PinSummaryConverter x:Key="PinSummary"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Search box: light gray fill, no border, radius 10 per the design -->
    <Style Selector="TextBox.searchbox">
      <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="30,8,10,8"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style Selector="TextBox.searchbox:focus">
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
    </Style>
    <Style Selector="TextBox.searchbox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <!-- Group header (design: small uppercase gray text) -->
    <Style Selector="TextBlock.sectiontitle">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextTertiary}"/>
      <Setter Property="Margin" Value="4,14,0,8"/>
    </Style>
    <!-- Node library list item -->
    <Style Selector="Border.libitem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="5"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="RenderTransformOrigin" Value="0%,50%"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.libitem:pointerover">
      <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
    </Style>
    <Style Selector="Border.libitem:pressed">
      <Setter Property="Background" Value="{DynamicResource BrushSurfacePressed}"/>
    </Style>
    <!-- Selected state: slight scale-up + light purple background + purple bar on the left -->
    <Style Selector="Border.libitem.selected">
      <Setter Property="Background" Value="{DynamicResource BrushDlgSidebarItemActiveBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBrandViolet}"/>
      <Setter Property="BorderThickness" Value="3,0,0,0"/>
      <Setter Property="Padding" Value="2,5,5,5"/>
      <Setter Property="RenderTransform" Value="scale(1.08,1.08)"/>
    </Style>
    <!-- Type icon tile (design: colored rounded square + white initial) -->
    <Style Selector="Border.caticon">
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
    </Style>
  </UserControl.Styles>

  <!-- Right-side node library -->
  <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1,0,0,0">
    <DockPanel Margin="16,18,16,10">
      <TextBlock DockPanel.Dock="Top"
                 Text="{Binding [Components], Source={x:Static s:Loc.Instance}}"
                 FontWeight="Bold" FontSize="15"
                 Foreground="{DynamicResource BrushTextPrimary}" Margin="5,0,0,14"/>

      <!-- Search box -->
      <Grid DockPanel.Dock="Top" Margin="5,0,0,4">
        <TextBox Classes="searchbox" Text="{Binding SearchText, Mode=TwoWay}"
                 PlaceholderText="{Binding [Search], Source={x:Static s:Loc.Instance}}"/>
        <Path Data="M416 208c0 45.9-14.9 88.3-40 122.7L502.6 457.4c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L330.7 376c-34.4 25.2-76.8 40-122.7 40C93.1 416 0 322.9 0 208S93.1 0 208 0S416 93.1 416 208zM208 352a144 144 0 1 0 0-288 144 144 0 1 0 0 288z"
              Fill="#4B5563" Width="14" Height="14"
              Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
              Stretch="Uniform" IsHitTestVisible="False"/>
      </Grid>

      <!-- Node list (sorted A-Z by name; click to add / drag onto the canvas) -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0">
        <ItemsControl ItemsSource="{Binding PaletteItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PaletteItem">
              <Border Classes="libitem" Margin="0,0,0,2"
                      PointerPressed="OnItemPointerPressed"
                      PointerMoved="OnItemPointerMoved"
                      PointerReleased="OnItemPointerReleased"
                      DoubleTapped="OnItemDoubleTapped">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Grid.Column="0" Classes="caticon" Background="{Binding Accent}">
                    <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}"
                               FontSize="10" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="Medium"
                               Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Name}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
