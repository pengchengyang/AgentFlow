<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AgentFlow.ViewModels"
             xmlns:s="clr-namespace:AgentFlow.Services"
             x:Class="AgentFlow.Views.NodeLibraryView"
             x:DataType="vm:NodeLibraryViewModel">

  <UserControl.Styles>
    <!-- 搜索框：聚焦边框改黑色，去掉蓝色高亮 -->
    <Style Selector="TextBox">
      <Setter Property="BorderBrush" Value="#D1D5DB"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="Black"/>
    </Style>
    <!-- 节点库列表项 -->
    <Style Selector="Border.libitem">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,9"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.libitem:pointerover">
      <Setter Property="Background" Value="#F3F4F6"/>
    </Style>
    <Style Selector="Border.libitem:pressed">
      <Setter Property="Background" Value="#E5E7EB"/>
    </Style>
  </UserControl.Styles>

  <!-- 右侧节点库 -->
  <Border Background="White" BorderBrush="#C0C4CC" BorderThickness="1,0,0,0">
    <DockPanel Margin="12,14">
      <TextBlock DockPanel.Dock="Top"
                 Text="{Binding [Components], Source={x:Static s:Loc.Instance}}"
                 FontWeight="SemiBold" FontSize="13" Foreground="#111827" Margin="4,0,0,10"/>

      <!-- 搜索框 -->
      <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
        <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                 Padding="28,7,8,7" FontSize="13"
                 PlaceholderText="{Binding [Search], Source={x:Static s:Loc.Instance}}"/>
        <Path Data="M416 208c0 45.9-14.9 88.3-40 122.7L502.6 457.4c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L330.7 376c-34.4 25.2-76.8 40-122.7 40C93.1 416 0 322.9 0 208S93.1 0 208 0S416 93.1 416 208zM208 352a144 144 0 1 0 0-288 144 144 0 1 0 0 288z" Fill="#111827" Width="14" Height="14" Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" Stretch="Uniform" VerticalAlignment="Center"/>
      </Grid>

      <!-- 节点列表（点击添加 / 拖拽到画布） -->
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding PaletteItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:PaletteItem">
              <Border Classes="libitem" Margin="0,0,0,4"
                      PointerPressed="OnItemPointerPressed"
                      PointerMoved="OnItemPointerMoved"
                      PointerReleased="OnItemPointerReleased">
                <Grid ColumnDefinitions="Auto,*">
                  <Path Grid.Column="0" Data="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z" Stretch="Uniform" Fill="#111827" Width="16" Height="16" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                               Foreground="#111827"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>

