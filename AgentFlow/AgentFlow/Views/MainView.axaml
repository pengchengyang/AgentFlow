<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AgentFlow.ViewModels"
             xmlns:views="clr-namespace:AgentFlow.Views"
             xmlns:s="clr-namespace:AgentFlow.Services"
             x:Class="AgentFlow.Views.MainView"
             x:DataType="vm:MainViewModel">
  <UserControl.Resources>
    <s:BoolToRowSpanConverter x:Key="RowSpan"/>
    <s:BoolToRowConverter x:Key="BoolToRow"/>
    <s:BoolToPanelHeightConverter x:Key="PanelHeight"/>
    <s:InvertBoolConverter x:Key="InvertBool"/>
  </UserControl.Resources>
  <UserControl.KeyBindings>
    <KeyBinding Command="{Binding SaveAsCommand}" Gesture="Ctrl+S"/>
    <KeyBinding Command="{Binding OpenCommand}" Gesture="Ctrl+O"/>
  </UserControl.KeyBindings>
  <Grid Background="{DynamicResource BrushCanvas}">
    <Grid RowDefinitions="*,28">
      <!-- Top: canvas + collapsible log panel, right-side component sidebar -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <Grid Grid.Column="0" RowDefinitions="*,Auto">
          <Grid Grid.Row="0" IsVisible="{Binding IsLogPanelExpanded, Converter={StaticResource InvertBool}}">
            <views:CanvasView DataContext="{Binding Canvas}"/>
          </Grid>
          <!-- Log panel (expanded/collapsed by the Log button) -->
          <views:LogPanelView Grid.Row="{Binding IsLogPanelExpanded, Converter={StaticResource BoolToRow}}" DataContext="{Binding LogPanel}" IsVisible="{Binding IsLogPanelOpen}" Grid.RowSpan="{Binding IsLogPanelExpanded, Converter={StaticResource RowSpan}}" Height="{Binding IsLogPanelExpanded, Converter={StaticResource PanelHeight}}"/>
        </Grid>
        <!-- Right-side node library -->
        <views:NodeLibraryView Grid.Column="1" Width="288" DataContext="{Binding NodeLibrary}" IsVisible="{Binding IsSidebarVisible}"/>
      </Grid>

      <!-- Bottom: status bar spanning the full window width to the far right -->
      <Border Grid.Row="1" Background="{DynamicResource BrushCard}"
              BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
          <Button Grid.Column="0" Classes="ghost" Command="{Binding ToggleLogPanelCommand}"
                  Padding="6,3" CornerRadius="7"
                  ToolTip.Tip="{Binding [Log], Source={x:Static s:Loc.Instance}}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Path Data="M3 5h1 M3 12h1 M3 19h1 M8 5h1 M8 12h1 M8 19h1 M13 5h8 M13 12h8 M13 19h8"
                    Stretch="Uniform" Stroke="#FDE68A" StrokeThickness="2"
                    StrokeLineCap="Round"
                    Width="12" Height="12" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding [Log], Source={x:Static s:Loc.Instance}}"
                         FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <TextBlock Grid.Column="1" Text="{Binding CurrentFilePath}" FontSize="11"
                     Foreground="{DynamicResource BrushTextSecondary}"
                     VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <!-- Running indicator: lightning bolt + "Running" + 3 animated dots -->
            <Path Data="M13 2L3 14h9l-1 8 10-12h-9l1-8z"
                  Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center"
                  Fill="{Binding RunningIconBrush}">
              <Path.Effect>
                <DropShadowEffect Color="#16A34A" BlurRadius="{Binding PulseBlur}" OffsetX="0" OffsetY="0"/>
              </Path.Effect>
            </Path>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding RunningText}" FontSize="11"
                         Foreground="{Binding RunningIconBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="." FontSize="11" Foreground="{Binding RunningIconBrush}"
                         Opacity="{Binding Dot1Opacity}" VerticalAlignment="Center"/>
              <TextBlock Text="." FontSize="11" Foreground="{Binding RunningIconBrush}"
                         Opacity="{Binding Dot2Opacity}" VerticalAlignment="Center"/>
              <TextBlock Text="." FontSize="11" Foreground="{Binding RunningIconBrush}"
                         Opacity="{Binding Dot3Opacity}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding Canvas.ZoomText}" FontSize="11"
                       Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
            <Path Data="M128 96l0 64 128 0 0-64c0-35.3-28.7-64-64-64s-64 28.7-64 64zM64 160l0-64C64 25.3 121.3-32 192-32S320 25.3 320 96l0 64c35.3 0 64 28.7 64 64l0 224c0 35.3-28.7 64-64 64L64 512c-35.3 0-64-28.7-64-64L0 224c0-35.3 28.7-64 64-64z"
                  Stretch="Uniform" Fill="{DynamicResource BrushTextTertiary}"
                  Width="12" Height="14" VerticalAlignment="Center"
                  IsVisible="{Binding !IsAdmin}"/>
            <Button Classes="ghost" Command="{Binding ToggleSidebarCommand}"
                    IsVisible="{Binding IsAdmin}" ToolTip.Tip="{Binding [ToggleSidebar], Source={x:Static s:Loc.Instance}}"
                    Padding="2" CornerRadius="6">
              <Grid Width="12" Height="12">
                <Path Data="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L77.3 256 214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"
                      Stretch="Uniform" Fill="{DynamicResource BrushTextSecondary}" Width="12" Height="12"
                      IsVisible="{Binding IsSidebarVisible}"/>
                <Path Data="M247.1 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L179.2 256 41.9 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"
                      Stretch="Uniform" Fill="{DynamicResource BrushTextSecondary}" Width="12" Height="12"
                      IsVisible="{Binding !IsSidebarVisible}"/>
              </Grid>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>


