<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AgentFlow.ViewModels"
             xmlns:views="clr-namespace:AgentFlow.Views"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="810"
             x:Class="AgentFlow.Views.MainView"
             x:DataType="vm:MainViewModel">

  <Grid RowDefinitions="Auto,*,40" Background="#F5F5F5">
    <views:TopBarView Grid.Row="0"/>

    <Grid Grid.Row="1" ColumnDefinitions="44,260,*">
      <!-- 最左侧图标工具栏 -->
      <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
        <Border.Styles>
          <Style Selector="Button.toolbtn">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
          </Style>
          <Style Selector="Button.toolbtn:pointerover">
            <Setter Property="Background" Value="#F3F4F6"/>
          </Style>
          <Style Selector="Button.toolbtn:pressed">
            <Setter Property="Background" Value="#E5E7EB"/>
          </Style>
          <Style Selector="Button.toolbtn:disabled">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="1"/>
          </Style>
        </Border.Styles>
        <StackPanel Spacing="2" Margin="0,8">
          <TextBlock Text="≡" FontSize="18" Foreground="#111827" HorizontalAlignment="Center" Margin="0,6,0,10"/>
          <Button Classes="toolbtn" Command="{Binding RunCommand}" IsEnabled="{Binding !IsRunning}" ToolTip.Tip="Run">
            <TextBlock Text="▶" FontSize="14" Foreground="#10B981"/>
          </Button>
          <Button Classes="toolbtn" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" ToolTip.Tip="Stop">
            <TextBlock Text="■" FontSize="13" Foreground="#EF4444"/>
          </Button>
          <Button Classes="toolbtn" Content="✎" FontSize="15"/>
          <Button Classes="toolbtn" Content="⊞" FontSize="15"/>
          <Button Classes="toolbtn" Content="📁" FontSize="15"/>
        </StackPanel>
      </Border>

      <views:PaletteView Grid.Column="1"/>
      <views:CanvasView Grid.Column="2"/>
    </Grid>

    <!-- 底部条 -->
    <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <Button Grid.Column="0" Classes="ghost" Content="+  New Custom Component"
                FontSize="13" Foreground="#374151" Margin="12,0,0,0" Padding="8,4"/>
        <Button Grid.Column="1" Classes="secondary" Content="›_  Logs"
                FontSize="13" Padding="12,4" Margin="8,0,0,0"/>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="0,0,12,0" VerticalAlignment="Center">
          <TextBlock Text="🔒" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
          <TextBlock Text="100%" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
          <TextBlock Text="⌃⌄" FontSize="10" Foreground="#9CA3AF" VerticalAlignment="Center"/>
          <Border Width="20" Height="20" CornerRadius="10" Background="#F3F4F6" VerticalAlignment="Center">
            <TextBlock Text="?" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
