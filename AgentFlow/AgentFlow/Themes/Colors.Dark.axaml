<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================
         AgentFlow Dark Theme resources
         Structurally identical to the light theme; only the color values differ.
         ================================================================ -->

    <!-- ============ Brand primary color (Violet, brightened for the dark theme) ============ -->
    <Color x:Key="Brand50">#1E1B4B</Color>
    <Color x:Key="Brand100">#2E1065</Color>
    <Color x:Key="Brand200">#4C1D95</Color>
    <Color x:Key="Brand300">#6D28D9</Color>
    <Color x:Key="Brand400">#7C3AED</Color>
    <Color x:Key="Brand500">#8B5CF6</Color>
    <Color x:Key="Brand600">#A78BFA</Color>
    <Color x:Key="Brand700">#C4B5FD</Color>
    <Color x:Key="BrandViolet">#A78BFA</Color>
    <Color x:Key="BrandDeep">#8B5CF6</Color>
    <Color x:Key="BrandSoft">#2E1065</Color>

    <!-- ============ Avalonia official brand blue (used for the logo) ============ -->
    <Color x:Key="AvaloniaBlue">#60A5FA</Color>

    <!-- ============ Node category colors (brightened for the dark theme) ============ -->
    <Color x:Key="CatInput">#60A5FA</Color>
    <Color x:Key="CatLogic">#A78BFA</Color>
    <Color x:Key="CatOutput">#FB7185</Color>
    <Color x:Key="CatFlow">#2DD4BF</Color>
    <Color x:Key="CatGeneral">#94A3B8</Color>
    <Color x:Key="CatAmplifier">#FBBF24</Color>

    <!-- ============ Text colors ============ -->
    <Color x:Key="TextPrimary">#F9FAFB</Color>
    <Color x:Key="TextSecondary">#D1D5DB</Color>
    <Color x:Key="TextTertiary">#94A3B8</Color>
    <Color x:Key="TextInverse">#FFFFFF</Color>
    <Color x:Key="TextOnBrand">#FFFFFF</Color>

    <!-- ============ Backgrounds / borders ============ -->
    <Color x:Key="CanvasBg">#0F172A</Color>
    <Color x:Key="CanvasDot">#1E293B</Color>
    <Color x:Key="CardBg">#1E293B</Color>
    <Color x:Key="SurfaceBg">#1E293B</Color>
    <Color x:Key="SurfaceHover">#334155</Color>
    <Color x:Key="SurfacePressed">#475569</Color>
    <Color x:Key="BorderLight">#334155</Color>
    <Color x:Key="BorderStrong">#475569</Color>
    <Color x:Key="BorderFocus">#A78BFA</Color>
    <Color x:Key="TitleBarBg">#1E293B</Color>
    <Color x:Key="PillBg">#334155</Color>
    <Color x:Key="ShadowNode">#40000000</Color>

    <!-- ============ Semantic colors (brightened for the dark theme) ============ -->
    <Color x:Key="Danger">#F87171</Color>
    <Color x:Key="DangerBg">#7F1D1D</Color>
    <Color x:Key="Success">#34D399</Color>
    <Color x:Key="SuccessBg">#064E3B</Color>
    <Color x:Key="Warning">#FBBF24</Color>
    <Color x:Key="WarningBg">#78350F</Color>

    <!-- ============ Canvas / node drawing colors ============ -->
    <Color x:Key="NodeCardBg">#1E293B</Color>
    <Color x:Key="NodeBorder">#334155</Color>
    <Color x:Key="NodeSelected">#A78BFA</Color>
    <Color x:Key="NodeShadow">#40000000</Color>
    <Color x:Key="NodeTitle">#F1F5F9</Color>
    <Color x:Key="NodeName">#CBD5E1</Color>
    <Color x:Key="NodeMuted">#64748B</Color>
    <Color x:Key="NodeDivider">#334155</Color>
    <Color x:Key="ConnLine">#475569</Color>
    <Color x:Key="PinInput">#60A5FA</Color>
    <Color x:Key="PinOutput">#A78BFA</Color>
    <Color x:Key="PinBorder">#334155</Color>

    <!-- ============ Brushes (referenced directly by XAML / code) ============ -->
    <SolidColorBrush x:Key="BrushBrand" Color="{StaticResource Brand500}" />
    <SolidColorBrush x:Key="BrushBrandHover" Color="{StaticResource Brand600}" />
    <SolidColorBrush x:Key="BrushBrandActive" Color="{StaticResource Brand700}" />
    <SolidColorBrush x:Key="BrushBrandSoft" Color="{StaticResource Brand100}" />
    <SolidColorBrush x:Key="BrushBrandFaint" Color="{StaticResource Brand50}" />
    <SolidColorBrush x:Key="BrushBrand300" Color="{StaticResource Brand300}" />
    <SolidColorBrush x:Key="BrushViolet" Color="{StaticResource BrandViolet}" />
    <SolidColorBrush x:Key="BrushAvaloniaBlue" Color="{StaticResource AvaloniaBlue}" />

    <!-- Design logo tile: diagonal gradient from Violet to Deep Violet -->
    <LinearGradientBrush x:Key="BrushBrandGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="{StaticResource BrandViolet}" Offset="0" />
        <GradientStop Color="{StaticResource BrandDeep}" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BrushCanvas" Color="{StaticResource CanvasBg}" />
    <SolidColorBrush x:Key="BrushCard" Color="{StaticResource CardBg}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource SurfaceBg}" />
    <SolidColorBrush x:Key="BrushSurfaceHover" Color="{StaticResource SurfaceHover}" />
    <SolidColorBrush x:Key="BrushSurfacePressed" Color="{StaticResource SurfacePressed}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource BorderLight}" />
    <SolidColorBrush x:Key="BrushBorderStrong" Color="{StaticResource BorderStrong}" />
    <SolidColorBrush x:Key="BrushBorderFocus" Color="{StaticResource BorderFocus}" />
    <SolidColorBrush x:Key="BrushTitleBar" Color="{StaticResource TitleBarBg}" />
    <SolidColorBrush x:Key="BrushPill" Color="{StaticResource PillBg}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="BrushTextTertiary" Color="{StaticResource TextTertiary}" />
    <SolidColorBrush x:Key="BrushTextInverse" Color="{StaticResource TextInverse}" />

    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource Danger}" />
    <SolidColorBrush x:Key="BrushDangerBg" Color="{StaticResource DangerBg}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="BrushSuccessBg" Color="{StaticResource SuccessBg}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource Warning}" />
    <SolidColorBrush x:Key="BrushWarningBg" Color="{StaticResource WarningBg}" />

    <!-- Backward compatibility (BrushIconFill etc. used by some views) -->
    <SolidColorBrush x:Key="BrushIconFill" Color="{StaticResource TextPrimary}" />

    <!-- Node category brushes (read from resources by NodeViewModel) -->
    <SolidColorBrush x:Key="BrushCatInput" Color="{StaticResource CatInput}" />
    <SolidColorBrush x:Key="BrushCatLogic" Color="{StaticResource CatLogic}" />
    <SolidColorBrush x:Key="BrushCatOutput" Color="{StaticResource CatOutput}" />
    <SolidColorBrush x:Key="BrushCatFlow" Color="{StaticResource CatFlow}" />
    <SolidColorBrush x:Key="BrushCatGeneral" Color="{StaticResource CatGeneral}" />
    <SolidColorBrush x:Key="BrushCatAmplifier" Color="{StaticResource CatAmplifier}" />

    <!-- Canvas/node drawing brushes (read from resources by CanvasView.axaml.cs) -->
    <SolidColorBrush x:Key="BrushNodeCard" Color="{StaticResource NodeCardBg}" />
    <SolidColorBrush x:Key="BrushNodeBorder" Color="{StaticResource NodeBorder}" />
    <SolidColorBrush x:Key="BrushNodeSelected" Color="{StaticResource NodeSelected}" />
    <SolidColorBrush x:Key="BrushNodeTitle" Color="{StaticResource NodeTitle}" />
    <SolidColorBrush x:Key="BrushNodeName" Color="{StaticResource NodeName}" />
    <SolidColorBrush x:Key="BrushNodeMuted" Color="{StaticResource NodeMuted}" />
    <SolidColorBrush x:Key="BrushNodeDivider" Color="{StaticResource NodeDivider}" />
    <SolidColorBrush x:Key="BrushConnLine" Color="{StaticResource ConnLine}" />
    <SolidColorBrush x:Key="BrushPinInput" Color="{StaticResource PinInput}" />
    <SolidColorBrush x:Key="BrushPinOutput" Color="{StaticResource PinOutput}" />
    <SolidColorBrush x:Key="BrushPinBorder" Color="{StaticResource PinBorder}" />


    <!-- ============ Toolbar light function buttons ============ -->
    <Color x:Key="OpenBg">#082F49</Color>      <Color x:Key="OpenFg">#7DD3FC</Color>
    <Color x:Key="SaveBg">#1E1B4B</Color>      <Color x:Key="SaveFg">#A5B4FC</Color>
    <Color x:Key="ClearBg">#4C0519</Color>     <Color x:Key="ClearFg">#FDA4AF</Color>
    <Color x:Key="ResetBg">#451A03</Color>     <Color x:Key="ResetFg">#FCD34D</Color>
    <Color x:Key="LoginBg">#2E1065</Color>     <Color x:Key="LoginFg">#C4B5FD</Color>

    <SolidColorBrush x:Key="BrushOpenBg" Color="{StaticResource OpenBg}" />
    <SolidColorBrush x:Key="BrushOpenFg" Color="{StaticResource OpenFg}" />
    <SolidColorBrush x:Key="BrushSaveBg" Color="{StaticResource SaveBg}" />
    <SolidColorBrush x:Key="BrushSaveFg" Color="{StaticResource SaveFg}" />
    <SolidColorBrush x:Key="BrushClearBg" Color="{StaticResource ClearBg}" />
    <SolidColorBrush x:Key="BrushClearFg" Color="{StaticResource ClearFg}" />
    <SolidColorBrush x:Key="BrushResetBg" Color="{StaticResource ResetBg}" />
    <SolidColorBrush x:Key="BrushResetFg" Color="{StaticResource ResetFg}" />
    <SolidColorBrush x:Key="BrushLoginBg" Color="{StaticResource LoginBg}" />
    <SolidColorBrush x:Key="BrushLoginFg" Color="{StaticResource LoginFg}" />

    <!-- ============ Window buttons (minimize / maximize / close) ============ -->
    <Color x:Key="MinBtnBg">#064E3B</Color>      <Color x:Key="MinBtnHoverBg">#065F46</Color>    <Color x:Key="MinBtnPressedBg">#047857</Color>    <Color x:Key="MinBtnFg">#34D399</Color>
    <Color x:Key="MaxBtnBg">#2E1065</Color>      <Color x:Key="MaxBtnHoverBg">#4C1D95</Color>    <Color x:Key="MaxBtnPressedBg">#6D28D9</Color>    <Color x:Key="MaxBtnFg">#C4B5FD</Color>
    <Color x:Key="CloseBtnBg">#4C0519</Color>    <Color x:Key="CloseBtnHoverBg">#881337</Color>  <Color x:Key="CloseBtnPressedBg">#9F1239</Color>   <Color x:Key="CloseBtnFg">#FB7185</Color>

    <SolidColorBrush x:Key="BrushMinBtnBg" Color="{StaticResource MinBtnBg}" />
    <SolidColorBrush x:Key="BrushMinBtnHoverBg" Color="{StaticResource MinBtnHoverBg}" />
    <SolidColorBrush x:Key="BrushMinBtnPressedBg" Color="{StaticResource MinBtnPressedBg}" />
    <SolidColorBrush x:Key="BrushMinBtnFg" Color="{StaticResource MinBtnFg}" />
    <SolidColorBrush x:Key="BrushMaxBtnBg" Color="{StaticResource MaxBtnBg}" />
    <SolidColorBrush x:Key="BrushMaxBtnHoverBg" Color="{StaticResource MaxBtnHoverBg}" />
    <SolidColorBrush x:Key="BrushMaxBtnPressedBg" Color="{StaticResource MaxBtnPressedBg}" />
    <SolidColorBrush x:Key="BrushMaxBtnFg" Color="{StaticResource MaxBtnFg}" />
    <SolidColorBrush x:Key="BrushCloseBtnBg" Color="{StaticResource CloseBtnBg}" />
    <SolidColorBrush x:Key="BrushCloseBtnHoverBg" Color="{StaticResource CloseBtnHoverBg}" />
    <SolidColorBrush x:Key="BrushCloseBtnPressedBg" Color="{StaticResource CloseBtnPressedBg}" />
    <SolidColorBrush x:Key="BrushCloseBtnFg" Color="{StaticResource CloseBtnFg}" />

    <!-- ============ Dialog / panel-specific colors ============ -->
    <Color x:Key="DlgSidebarBg">#0B1220</Color>
    <Color x:Key="DlgSidebarItemBg">#334155</Color>
    <Color x:Key="DlgSidebarItemActiveBg">#2E1065</Color>
    <Color x:Key="DlgContentBg">#1E293B</Color>
    <Color x:Key="DlgGroupBg">#0F172A</Color>
    <Color x:Key="DlgGroupHoverBg">#2E1065</Color>
    <Color x:Key="DlgGroupBorder">#334155</Color>
    <Color x:Key="DlgGroupSelectedBorder">#A78BFA</Color>
    <Color x:Key="DlgSecondaryText">#E2E8F0</Color>
    <Color x:Key="DlgMutedText">#94A3B8</Color>
    <Color x:Key="DlgButtonBg">#334155</Color>
    <Color x:Key="DlgButtonHoverBg">#475569</Color>
    <Color x:Key="DlgButtonPressedBg">#64748B</Color>
    <Color x:Key="DlgPrimaryBtnBg">#7C3AED</Color>
    <Color x:Key="DlgPrimaryBtnHoverBg">#6D28D9</Color>

    <SolidColorBrush x:Key="BrushDlgSidebarBg" Color="{StaticResource DlgSidebarBg}" />
    <SolidColorBrush x:Key="BrushDlgSidebarItemBg" Color="{StaticResource DlgSidebarItemBg}" />
    <SolidColorBrush x:Key="BrushDlgSidebarItemActiveBg" Color="{StaticResource DlgSidebarItemActiveBg}" />
    <SolidColorBrush x:Key="BrushDlgContentBg" Color="{StaticResource DlgContentBg}" />
    <SolidColorBrush x:Key="BrushDlgGroupBg" Color="{StaticResource DlgGroupBg}" />
    <SolidColorBrush x:Key="BrushDlgGroupHoverBg" Color="{StaticResource DlgGroupHoverBg}" />
    <SolidColorBrush x:Key="BrushDlgGroupBorder" Color="{StaticResource DlgGroupBorder}" />
    <SolidColorBrush x:Key="BrushDlgGroupSelectedBorder" Color="{StaticResource DlgGroupSelectedBorder}" />
    <SolidColorBrush x:Key="BrushDlgSecondaryText" Color="{StaticResource DlgSecondaryText}" />
    <SolidColorBrush x:Key="BrushDlgMutedText" Color="{StaticResource DlgMutedText}" />
    <SolidColorBrush x:Key="BrushDlgButtonBg" Color="{StaticResource DlgButtonBg}" />
    <SolidColorBrush x:Key="BrushDlgButtonHoverBg" Color="{StaticResource DlgButtonHoverBg}" />
    <SolidColorBrush x:Key="BrushDlgButtonPressedBg" Color="{StaticResource DlgButtonPressedBg}" />
    <SolidColorBrush x:Key="BrushDlgPrimaryBtnBg" Color="{StaticResource DlgPrimaryBtnBg}" />
    <SolidColorBrush x:Key="BrushDlgPrimaryBtnHoverBg" Color="{StaticResource DlgPrimaryBtnHoverBg}" />

    <!-- ============ Stop button (solid red) ============ -->
    <Color x:Key="StopBtnBg">#DC2626</Color>
    <Color x:Key="StopBtnHoverBg">#B91C1C</Color>
    <Color x:Key="StopBtnPressedBg">#991B1B</Color>
    <Color x:Key="StopBtnDisabledBg">#334155</Color>
    <Color x:Key="StopBtnFg">#FFFFFF</Color>
    <Color x:Key="StopBtnDisabledFg">#64748B</Color>

    <SolidColorBrush x:Key="BrushStopBtnBg" Color="{StaticResource StopBtnBg}" />
    <SolidColorBrush x:Key="BrushStopBtnHoverBg" Color="{StaticResource StopBtnHoverBg}" />
    <SolidColorBrush x:Key="BrushStopBtnPressedBg" Color="{StaticResource StopBtnPressedBg}" />
    <SolidColorBrush x:Key="BrushStopBtnDisabledBg" Color="{StaticResource StopBtnDisabledBg}" />
    <SolidColorBrush x:Key="BrushStopBtnFg" Color="{StaticResource StopBtnFg}" />
    <SolidColorBrush x:Key="BrushStopBtnDisabledFg" Color="{StaticResource StopBtnDisabledFg}" />

    <!-- ============ Theme toggle button ============ -->
    <Color x:Key="ThemeBtnBg">#451A03</Color>
    <Color x:Key="ThemeBtnHoverBg">#78350F</Color>
    <Color x:Key="ThemeBtnPressedBg">#92400E</Color>
    <Color x:Key="ThemeBtnFg">#FBBF24</Color>

    <SolidColorBrush x:Key="BrushThemeBtnBg" Color="{StaticResource ThemeBtnBg}" />
    <SolidColorBrush x:Key="BrushThemeBtnHoverBg" Color="{StaticResource ThemeBtnHoverBg}" />
    <SolidColorBrush x:Key="BrushThemeBtnPressedBg" Color="{StaticResource ThemeBtnPressedBg}" />
    <SolidColorBrush x:Key="BrushThemeBtnFg" Color="{StaticResource ThemeBtnFg}" />
</ResourceDictionary>
