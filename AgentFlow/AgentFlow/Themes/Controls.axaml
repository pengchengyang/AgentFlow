<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Primary button (solid purple, used for main actions such as Run) ============ -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource BrushBrand}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextInverse}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrushBrandHover}" />
    </Style>
    <Style Selector="Button.primary:pressed">
        <Setter Property="Background" Value="{DynamicResource BrushBrandActive}" />
    </Style>
    <Style Selector="Button.primary:disabled">
        <Setter Property="Background" Value="{DynamicResource BrushBrand300}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextInverse}" />
    </Style>

    <!-- ============ Secondary button (white background, gray border) ============ -->
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource BrushCard}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.secondary:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}" />
    </Style>
    <Style Selector="Button.secondary:pressed">
        <Setter Property="Background" Value="{DynamicResource BrushSurfacePressed}" />
    </Style>

    <!-- ============ Small text button (language / home, etc.) ============ -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
    </Style>

    <!-- ============ Input box / search box ============ -->
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BrushCard}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource BrushTextTertiary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderFocus}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <!-- ============ Numeric input box ============ -->
    <Style Selector="NumericUpDown">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ============ Title-bar tool button (designed 36x36 / corner radius 10 / borderless) ============ -->
    <Style Selector="Button.toolbtn">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.toolbtn:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
    </Style>
    <Style Selector="Button.toolbtn:pressed">
        <Setter Property="Background" Value="{DynamicResource BrushSurfacePressed}" />
    </Style>
    <Style Selector="Button.toolbtn:disabled">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="0.35" />
    </Style>

    <!-- Primary action: solid purple (the design play button) -->
    <Style Selector="Button.toolbtn.run">
        <Setter Property="Background" Value="{DynamicResource BrushSuccessBg}" />
    </Style>
    <Style Selector="Button.toolbtn.run:pointerover">
        <Setter Property="Background" Value="#A7F3D0" />
    </Style>
    <Style Selector="Button.toolbtn.run:pressed">
        <Setter Property="Background" Value="#6EE7B7" />
    </Style>
    <Style Selector="Button.toolbtn.run:disabled">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.toolbtn.run:disabled Path">
        <Setter Property="Fill" Value="{DynamicResource BrushTextTertiary}" />
    </Style>
    <Style Selector="Button.toolbtn.run Path">
        <Setter Property="Fill" Value="{DynamicResource BrushSuccess}" />
    </Style>

    <!-- ============ Light-colored function buttons (Open / Save / Clear / Reset / Login) ============ -->
    <Style Selector="Button.toolbtn.open">
        <Setter Property="Background" Value="{DynamicResource BrushOpenBg}" />
    </Style>
    <Style Selector="Button.toolbtn.open:pointerover">
        <Setter Property="Background" Value="#BFE0F9" />
    </Style>
    <Style Selector="Button.toolbtn.open:pressed">
        <Setter Property="Background" Value="#9ED0F3" />
    </Style>
    <Style Selector="Button.toolbtn.save">
        <Setter Property="Background" Value="{DynamicResource BrushSaveBg}" />
    </Style>
    <Style Selector="Button.toolbtn.save:pointerover">
        <Setter Property="Background" Value="#CBD6FC" />
    </Style>
    <Style Selector="Button.toolbtn.save:pressed">
        <Setter Property="Background" Value="#B3C2F9" />
    </Style>
    <Style Selector="Button.toolbtn.clear">
        <Setter Property="Background" Value="{DynamicResource BrushClearBg}" />
    </Style>
    <Style Selector="Button.toolbtn.clear:pointerover">
        <Setter Property="Background" Value="#FFD3D8" />
    </Style>
    <Style Selector="Button.toolbtn.clear:pressed">
        <Setter Property="Background" Value="#FFB9C1" />
    </Style>
    <Style Selector="Button.toolbtn.reset">
        <Setter Property="Background" Value="{DynamicResource BrushResetBg}" />
    </Style>
    <Style Selector="Button.toolbtn.reset:pointerover">
        <Setter Property="Background" Value="#FCE9AE" />
    </Style>
    <Style Selector="Button.toolbtn.reset:pressed">
        <Setter Property="Background" Value="#FADC8C" />
    </Style>
    <Style Selector="Button.toolbtn.login">
        <Setter Property="Background" Value="{DynamicResource BrushLoginBg}" />
    </Style>
    <Style Selector="Button.toolbtn.login:pointerover">
        <Setter Property="Background" Value="#E2D8F8" />
    </Style>
    <Style Selector="Button.toolbtn.login:pressed">
        <Setter Property="Background" Value="#D6C6F5" />
    </Style>
    <Style Selector="Button.toolbtn.theme">
        <Setter Property="Background" Value="{DynamicResource BrushThemeBtnBg}" />
    </Style>
    <Style Selector="Button.toolbtn.theme:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrushThemeBtnHoverBg}" />
    </Style>
    <Style Selector="Button.toolbtn.theme:pressed">
        <Setter Property="Background" Value="{DynamicResource BrushThemeBtnPressedBg}" />
    </Style>
    <Style Selector="Button.toolbtn.theme Path">
        <Setter Property="Stroke" Value="{DynamicResource BrushThemeBtnFg}" />
    </Style>
    <!-- Stop: solid dark (the design black square button) -->
    <Style Selector="Button.toolbtn.dark">
        <Setter Property="Background" Value="{DynamicResource BrushStopBtnBg}" />
    </Style>
    <Style Selector="Button.toolbtn.dark:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrushStopBtnHoverBg}" />
    </Style>
    <Style Selector="Button.toolbtn.dark:pressed">
        <Setter Property="Background" Value="{DynamicResource BrushStopBtnPressedBg}" />
    </Style>
    <Style Selector="Button.toolbtn.dark:disabled">
        <Setter Property="Background" Value="{DynamicResource BrushStopBtnDisabledBg}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.toolbtn.dark:disabled Path">
        <Setter Property="Fill" Value="{DynamicResource BrushStopBtnDisabledFg}" />
    </Style>
    <Style Selector="Button.toolbtn.dark Path">
        <Setter Property="Fill" Value="{DynamicResource BrushStopBtnFg}" />
    </Style>

    <!-- ============ Window buttons (minimize / maximize / close) ============ -->
    <Style Selector="Button.winbtn">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.winbtn:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
    </Style>
    <Style Selector="Button.winbtn:pressed">
        <Setter Property="Background" Value="{DynamicResource BrushSurfacePressed}" />
    </Style>
    <Style Selector="Button.winbtn.close:pointerover">
        <Setter Property="Background" Value="#E81123" />
    </Style>
    <Style Selector="Button.winbtn.close:pointerover Path">
        <Setter Property="Fill" Value="White" />
    </Style>

    <!-- Window button light colors (minimize / maximize / close) -->
    <Style Selector="Button.winbtn.min">
        <Setter Property="Background" Value="{DynamicResource BrushMinBtnBg}" />
    </Style>
    <Style Selector="Button.winbtn.min:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrushMinBtnHoverBg}" />
    </Style>
    <Style Selector="Button.winbtn.min:pressed">
        <Setter Property="Background" Value="{DynamicResource BrushMinBtnPressedBg}" />
    </Style>
    <Style Selector="Button.winbtn.min Border">
        <Setter Property="Background" Value="{DynamicResource BrushMinBtnFg}" />
    </Style>

    <Style Selector="Button.winbtn.max">
        <Setter Property="Background" Value="{DynamicResource BrushMaxBtnBg}" />
    </Style>
    <Style Selector="Button.winbtn.max:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrushMaxBtnHoverBg}" />
    </Style>
    <Style Selector="Button.winbtn.max:pressed">
        <Setter Property="Background" Value="{DynamicResource BrushMaxBtnPressedBg}" />
    </Style>
    <Style Selector="Button.winbtn.max Path">
        <Setter Property="Fill" Value="{DynamicResource BrushMaxBtnFg}" />
    </Style>

    <Style Selector="Button.winbtn.close">
        <Setter Property="Background" Value="{DynamicResource BrushCloseBtnBg}" />
    </Style>
    <Style Selector="Button.winbtn.close:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrushCloseBtnHoverBg}" />
    </Style>
    <Style Selector="Button.winbtn.close:pressed">
        <Setter Property="Background" Value="{DynamicResource BrushCloseBtnPressedBg}" />
    </Style>
    <Style Selector="Button.winbtn.close Path">
        <Setter Property="Fill" Value="{DynamicResource BrushCloseBtnFg}" />
    </Style>


    <!-- ============ Log level filter Toggle buttons (light background + hover/pressed + selected border) ============ -->
    <Style Selector="ToggleButton.level">
        <Setter Property="Height" Value="26" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="ToggleButton.level.all">
        <Setter Property="Background" Value="#F1F5F9" />
        <Setter Property="Foreground" Value="#64748B" />
    </Style>
    <Style Selector="ToggleButton.level.all:pointerover">
        <Setter Property="Background" Value="#E2E8F0" />
    </Style>
    <Style Selector="ToggleButton.level.all:pressed">
        <Setter Property="Background" Value="#CBD5E1" />
    </Style>
    <Style Selector="ToggleButton.level.all:checked">
        <Setter Property="Background" Value="#CBD5E1" />
        <Setter Property="BorderBrush" Value="#64748B" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="ToggleButton.level.trace">
        <Setter Property="Background" Value="#F8FAFC" />
        <Setter Property="Foreground" Value="#94A3B8" />
    </Style>
    <Style Selector="ToggleButton.level.trace:pointerover">
        <Setter Property="Background" Value="#E2E8F0" />
    </Style>
    <Style Selector="ToggleButton.level.trace:pressed">
        <Setter Property="Background" Value="#CBD5E1" />
    </Style>
    <Style Selector="ToggleButton.level.trace:checked">
        <Setter Property="Background" Value="#CBD5E1" />
        <Setter Property="BorderBrush" Value="#94A3B8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="ToggleButton.level.debug">
        <Setter Property="Background" Value="#DBEAFE" />
        <Setter Property="Foreground" Value="#2563EB" />
    </Style>
    <Style Selector="ToggleButton.level.debug:pointerover">
        <Setter Property="Background" Value="#BFDBFE" />
    </Style>
    <Style Selector="ToggleButton.level.debug:pressed">
        <Setter Property="Background" Value="#93C5FD" />
    </Style>
    <Style Selector="ToggleButton.level.debug:checked">
        <Setter Property="Background" Value="#93C5FD" />
        <Setter Property="BorderBrush" Value="#2563EB" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="ToggleButton.level.info">
        <Setter Property="Background" Value="#EDE9FE" />
        <Setter Property="Foreground" Value="#7C3AED" />
    </Style>
    <Style Selector="ToggleButton.level.info:pointerover">
        <Setter Property="Background" Value="#DDD6FE" />
    </Style>
    <Style Selector="ToggleButton.level.info:pressed">
        <Setter Property="Background" Value="#C4B5FD" />
    </Style>
    <Style Selector="ToggleButton.level.info:checked">
        <Setter Property="Background" Value="#C4B5FD" />
        <Setter Property="BorderBrush" Value="#7C3AED" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="ToggleButton.level.warn">
        <Setter Property="Background" Value="#FEF3C7" />
        <Setter Property="Foreground" Value="#D97706" />
    </Style>
    <Style Selector="ToggleButton.level.warn:pointerover">
        <Setter Property="Background" Value="#FDE68A" />
    </Style>
    <Style Selector="ToggleButton.level.warn:pressed">
        <Setter Property="Background" Value="#FCD34D" />
    </Style>
    <Style Selector="ToggleButton.level.warn:checked">
        <Setter Property="Background" Value="#FCD34D" />
        <Setter Property="BorderBrush" Value="#D97706" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="ToggleButton.level.error">
        <Setter Property="Background" Value="#FEE2E2" />
        <Setter Property="Foreground" Value="#DC2626" />
    </Style>
    <Style Selector="ToggleButton.level.error:pointerover">
        <Setter Property="Background" Value="#FECACA" />
    </Style>
    <Style Selector="ToggleButton.level.error:pressed">
        <Setter Property="Background" Value="#FCA5A5" />
    </Style>
    <Style Selector="ToggleButton.level.error:checked">
        <Setter Property="Background" Value="#FCA5A5" />
        <Setter Property="BorderBrush" Value="#DC2626" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</Styles>




