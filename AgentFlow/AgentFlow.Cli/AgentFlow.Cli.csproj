<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AgentFlow.Core\AgentFlow.Core.csproj" />
    <ProjectReference Include="..\AgentFlow.Contracts\AgentFlow.Contracts.csproj" />
    <!-- Shared plugin dependency: RTS plugins reference AgentFlow.Shared, so the host must provide this assembly. -->
    <ProjectReference Include="..\AgentFlow.Shared\AgentFlow.Shared.csproj" />
    <!-- Shared plugin dependency: Node.Broadcast.Demo references BroadcastKit, so the host
         (even though the CLI no longer uses TopicBus itself) must provide this assembly. -->
    <ProjectReference Include="..\BroadcastKit\BroadcastKit.csproj" />
    <ProjectReference Include="..\BroadcastKit.Contracts\BroadcastKit.Contracts.csproj" />
    <ProjectReference Include="..\Hosting.Logging\Hosting.Logging.csproj" />
    <!-- Build the plugin projects as part of this project; they are not referenced
         assemblies (they are loaded from plugins/ at runtime). -->
    <PluginProjects Include="..\plugins\**\*.csproj" />
    <ProjectReference Include="@(PluginProjects)" ReferenceOutputAssembly="false" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- This project owns the plugin pipeline; see Directory.Build.targets. -->
    <PluginHost>true</PluginHost>
  </PropertyGroup>

  <!-- Plugin distribution (build + publish) is owned by Directory.Build.targets. -->
</Project>
