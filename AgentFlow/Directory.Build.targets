<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- Platform-specific plugin output folders use bin\<Platform>\<Configuration> on MSBuild. -->
    <PluginPlatformOutputPath Condition="'$(Platform)' != '' and '$(Platform)' != 'AnyCPU' and '$(Platform)' != 'Any CPU'">$(Platform)\</PluginPlatformOutputPath>
  </PropertyGroup>
  <Target Name="ValidateAgentFlowVersionMetadata" BeforeTargets="CoreCompile">
    <Error Condition="'$(AgentFlowHasVersionProps)' != 'true'"
           Text="$(MSBuildProjectName) must have its own Version.props file. Expected at $(AgentFlowVersionPropsPath)." />
    <Error Condition="'$(AssemblyVersion)' == '' or '$(FileVersion)' == '' or '$(InformationalVersion)' == ''"
           Text="$(MSBuildProjectName) must define AssemblyVersion, FileVersion, and InformationalVersion in Version.props." />
  </Target>
  <!--
    ================================================================================
    Plugin distribution
    ================================================================================
    A host project opts in with <PluginHost>true</PluginHost> and lists every plugin
    project in @(PluginProjects). The host owns its plugins/ output folder:

      * ordinary build:
          - plugin projects are built through their normal ProjectReferences;
          - the host's $(OutDir)plugins folder is emptied and refilled with exactly
            the plugin assemblies produced for the active configuration/platform.

      * publish:
          - after the SDK publish completes, the host explicitly builds every plugin
            project with the active Configuration and Platform;
          - publish-only properties such as RuntimeIdentifier, SelfContained,
            PublishSingleFile, PublishProfile and PublishDir are removed for those
            plugin builds;
          - $(PublishDir)plugins and $(OutDir)plugins are then emptied and refilled.

    The explicit publish-time plugin build is required because Visual Studio's publish
    pipeline can evaluate project references separately. Removing plugin outputs at the
    start of a host publish made those outputs disappear without guaranteeing that the
    same publish invocation would rebuild them.

    A locked (app running) or missing file fails the operation; nothing is skipped with
    ContinueOnError.

    Do not publish AgentFlow.Desktop and AgentFlow.Cli in the same build: both hosts
    write to their own output folders, but plugin project builds must not run concurrently.
  -->

  <Target Name="CopyPluginsToBuildOutput"
          AfterTargets="Build"
          Condition="'$(PluginHost)' == 'true' and '$(_IsPublishing)' != 'true'">
    <ItemGroup>
      <_BuildPluginProjects Include="@(PluginProjects->'%(FullPath)')" />
      <_BuildPluginDlls Include="@(_BuildPluginProjects->'%(RootDir)%(Directory)bin\$(PluginPlatformOutputPath)$(Configuration)\net8.0\%(Filename).dll')" />
      <_BuildMissingPluginDlls Include="@(_BuildPluginDlls)" Condition="!Exists('%(FullPath)')" />
    </ItemGroup>
    <Error Condition="'@(_BuildPluginDlls)' == ''"
           Text="$(MSBuildProjectName) has PluginHost=true but @(PluginProjects) is empty: no plugin assemblies to copy." />
    <Error Condition="'@(_BuildMissingPluginDlls)' != ''"
           Text="Plugin assemblies were not produced by this build: @(_BuildMissingPluginDlls). Build $(MSBuildProjectName) (or the solution) without the no build switch, and keep the plugin project name equal to its assembly name." />
    <RemoveDir Directories="$(OutDir)plugins" Condition="Exists('$(OutDir)plugins')" />
    <MakeDir Directories="$(OutDir)plugins" />
    <Copy SourceFiles="@(_BuildPluginDlls)" DestinationFolder="$(OutDir)plugins" SkipUnchangedFiles="false" />
    <Message Importance="normal" Text="Copied plugin assemblies to $(OutDir)plugins" />
  </Target>

  <Target Name="PublishFreshPlugins"
          AfterTargets="Publish"
          Condition="'$(PluginHost)' == 'true'">
    <ItemGroup>
      <_PublishPluginProjects Include="@(PluginProjects->'%(FullPath)')" />
      <_PublishPluginDlls Include="@(_PublishPluginProjects->'%(RootDir)%(Directory)bin\$(PluginPlatformOutputPath)$(Configuration)\net8.0\%(Filename).dll')" />
    </ItemGroup>
    <Error Condition="'@(_PublishPluginProjects)' == ''"
           Text="$(MSBuildProjectName) has PluginHost=true but @(PluginProjects) is empty: nothing to publish." />

    <!-- Always build plugins in the publish target. Visual Studio may not rebuild
         project references inside the same publish pipeline, especially when the SDK
         project uses a runtime identifier or single-file publishing. -->
    <MSBuild Projects="@(_PublishPluginProjects)"
             Targets="Build"
             BuildInParallel="false"
             RemoveProperties="NoBuild;RuntimeIdentifier;SelfContained;PublishSelfContained;PublishSingleFile;PublishReadyToRun;PublishTrimmed;PublishProfile;PublishDir;PublishProtocol;_TargetId;_IsPublishing"
             Properties="Configuration=$(Configuration);Platform=$(Platform)" />

    <ItemGroup>
      <_PublishMissingPluginDlls Include="@(_PublishPluginDlls)" Condition="!Exists('%(FullPath)')" />
    </ItemGroup>
    <Error Condition="'@(_PublishMissingPluginDlls)' != ''"
           Text="Plugin assemblies are missing when publishing: @(_PublishMissingPluginDlls)." />
    <RemoveDir Directories="$(PublishDir)plugins" Condition="Exists('$(PublishDir)plugins')" />
    <MakeDir Directories="$(PublishDir)plugins" />
    <Copy SourceFiles="@(_PublishPluginDlls)" DestinationFolder="$(PublishDir)plugins" SkipUnchangedFiles="false" />

    <!-- Keep the host's own build output (the exe run directly from bin) in sync too. -->
    <RemoveDir Directories="$(OutDir)plugins" Condition="Exists('$(OutDir)')" />
    <MakeDir Directories="$(OutDir)plugins" Condition="Exists('$(OutDir)')" />
    <Copy SourceFiles="@(_PublishPluginDlls)" DestinationFolder="$(OutDir)plugins" SkipUnchangedFiles="false" Condition="Exists('$(OutDir)')" />

    <Message Importance="High" Text="Published plugin assemblies to $(PublishDir)plugins" />
  </Target>
</Project>