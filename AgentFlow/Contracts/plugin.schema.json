{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentflow.local/Contracts/plugin.schema.json",
  "title": "AgentFlow external node package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "packageId",
    "displayName",
    "version",
    "worker",
    "nodeTypes"
  ],
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "packageId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\]+$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "worker": {
      "$ref": "#/$defs/worker"
    },
    "nodeTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nodeType"
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publisher": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "authorEmail": {
          "type": "string"
        },
        "copyright": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "licenseFile": {
          "type": "string",
          "minLength": 1
        },
        "homepage": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "executable"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workingDirectory": {
          "type": "string"
        },
        "startTimeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "heartbeatIntervalMs": {
          "type": "integer",
          "minimum": 1
        },
        "heartbeatTimeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "commandTimeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "maxLineBytes": {
          "type": "integer",
          "minimum": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "nodeType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeType",
        "displayName",
        "category",
        "pins"
      ],
      "properties": {
        "nodeType": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "const": "E"
        },
        "description": {
          "type": "string"
        },
        "pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pin"
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "subscriptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "direction",
        "dataType"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "input",
            "output",
            "Input",
            "Output"
          ]
        },
        "dataType": {
          "enum": [
            "STRING",
            "INT32",
            "INT64",
            "BOOL",
            "FLOAT",
            "DOUBLE",
            "BIN"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "allowNull": {
          "type": "boolean"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "string",
            "bool",
            "int32",
            "int64",
            "float",
            "double"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "defaultValue": {},
        "editable": {
          "type": "boolean"
        },
        "zone": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "editor": {
          "enum": [
            "auto",
            "text",
            "singleSelect",
            "multiSelect"
          ]
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sensitive": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "editor": {
                "enum": [
                  "singleSelect",
                  "multiSelect"
                ]
              }
            },
            "required": [
              "editor"
            ]
          },
          "then": {
            "required": [
              "options"
            ]
          }
        }
      ]
    }
  }
}
