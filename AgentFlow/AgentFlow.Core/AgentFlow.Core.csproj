<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AgentFlow.Contracts\AgentFlow.Contracts.csproj" />
    <ProjectReference Include="..\BroadcastKit\BroadcastKit.csproj" />
    <ProjectReference Include="..\BroadcastKit.Contracts\BroadcastKit.Contracts.csproj" />
  </ItemGroup>

  <!-- Logging infrastructure lives in the reusable Hosting.Logging project (referenced by the hosts).
       Core only depends on the ILogger abstractions, which come transitively from Contracts. -->

  <PropertyGroup>
    <TargetFramework>$(AgentFlowTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

</Project>
