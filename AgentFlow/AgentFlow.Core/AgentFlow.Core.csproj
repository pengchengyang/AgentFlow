<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AgentFlow.Contracts\AgentFlow.Contracts.csproj" />
  </ItemGroup>

  <!-- Logging infrastructure lives in the reusable Hosting.Logging project (referenced by the hosts).
       Core only depends on the ILogger abstractions, which come transitively from Contracts. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

</Project>


