<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(PluginTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPlugin>true</IsPlugin>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\AgentFlow.Contracts\AgentFlow.Contracts.csproj" />
    <ProjectReference Include="..\..\..\BroadcastKit\BroadcastKit.csproj" />
    <ProjectReference Include="..\..\..\BroadcastKit.Contracts\BroadcastKit.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Tools\NativeNodeCodeGen\NativeNodeCodeGen.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <NativeNodeProxyOutput Condition="'$(NativeNodeProxyOutput)' == ''">$(MSBuildThisFileDirectory)Generated\NativeNodeProxies.g.cs</NativeNodeProxyOutput>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Generated\NativeNodeProxies.g.cs" Condition="'$(NativeNodeProxyOutput)' != '$(MSBuildThisFileDirectory)Generated\NativeNodeProxies.g.cs'" />
    <Compile Include="$(NativeNodeProxyOutput)" Condition="'$(NativeNodeProxyOutput)' != '$(MSBuildThisFileDirectory)Generated\NativeNodeProxies.g.cs'" />
  </ItemGroup>
  <Target Name="GenerateNativeNodeProxies" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <NativeNodeCodeGenAssembly Condition="'$(NativeNodeCodeGenAssembly)' == ''">$(MSBuildThisFileDirectory)..\..\..\Tools\NativeNodeCodeGen\bin\$(PluginPlatformOutputPath)$(Configuration)\$(AgentFlowTargetFramework)\NativeNodeCodeGen.dll</NativeNodeCodeGenAssembly>
    </PropertyGroup>
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName($(NativeNodeProxyOutput)))" />
    <Exec Command="dotnet &quot;$(NativeNodeCodeGenAssembly)&quot; &quot;$(MSBuildThisFileDirectory)..\..\..&quot; &quot;$(MSBuildThisFileDirectory)..\Src&quot; &quot;$(NativeNodeProxyOutput)&quot;" />
  </Target>
</Project>
