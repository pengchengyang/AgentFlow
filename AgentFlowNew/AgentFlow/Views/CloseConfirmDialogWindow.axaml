<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AgentFlow.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="AgentFlow.Views.CloseConfirmDialogWindow"
        x:DataType="vm:CloseConfirmDialogViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Title}"
        Width="440" Height="220"
        MinWidth="400" MinHeight="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#F9FAFB">

    <Border Margin="1" Background="#F9FAFB">
        <DockPanel LastChildFill="True">

            <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button Classes="secondary" Content="Cancel"
                            Command="{Binding CancelCommand}" IsCancel="True" MinWidth="84"/>
                    <Button Classes="secondary" Content="Discard"
                            Command="{Binding DiscardCommand}" MinWidth="84"/>
                    <Button Classes="primary" Content="Save &amp; Exit"
                            Command="{Binding SaveAndExitCommand}" IsDefault="True" MinWidth="110"/>
                </StackPanel>
            </Border>

            <StackPanel Margin="20,20" Spacing="10" VerticalAlignment="Top">
                <TextBlock Text="⚠️" FontSize="18"/>
                <TextBlock Text="{Binding Message}" FontSize="13" Foreground="#374151" TextWrapping="Wrap"/>
            </StackPanel>

        </DockPanel>
    </Border>
</Window>
